        private LocalReport SetPrintReport(DataRowView user, xReportViewer viewer = null)
        {
            LocalReport _report;
            string _reportPath = String.Format(@"{0}\Prikaz-Naryad.rdlc", Application.StartupPath);
            if (viewer==null)
            {
                _report = new LocalReport();
                
            }
            else
            {
                _report = viewer.Report;
  
            }

            _report.ReportPath = _reportPath;

            var _dataSource = new PrikazNaryadReportItems(this.dateEdit1.DateTime, this.dateEdit2.DateTime, user.Row, m_WorkItemsData);

            BindingSource _bindingSource = new BindingSource() { DataSource = _dataSource };

            _report.DataSources.Add(new Microsoft.Reporting.WinForms.ReportDataSource("DataSet1", _bindingSource));

            _report.DataSources.Add(new Microsoft.Reporting.WinForms.ReportDataSource("DataSet2", _dataSource.List));
            _report.DisplayName = _dataSource.ToString();
            return _report;
        }
