        /// <summary>
        /// Обеспечивает импорт данных начислений по сделке в файл csv
        /// </summary>
        /// <param name="data"></param>
        /// <param name="fileName"></param>
        private void ImportToFile( IEnumerable<DataRow> data, string fileName)
        {            

            string _filePath = String.Format(@"{0}\{1}", Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), fileName);
            //создаем и записываем описание полей csv
            using (var writer = new StreamWriter(_filePath))
            {
                using (var csv = new CsvWriter(writer, CultureInfo.CurrentCulture))
                {

                    foreach (var _header in m_csvFieldsNames)
                    {
                        csv.WriteField(_header);
                    }
                    csv.NextRecord();
                }
            }


            //Определяем в конфигурации обработчика csv пропуск заголовков
            var config = new CsvHelper.Configuration.CsvConfiguration(CultureInfo.CurrentCulture)
            {

                HasHeaderRecord = false,

            };

            foreach (DataRow fjfjfjf in data)
            {
                PrikazNaryadReportItems _dataSource = new PrikazNaryadReportItems(this.dateEdit1.DateTime, this.dateEdit2.DateTime, fjfjfjf, m_WorkItemsData);

                using (var stream = File.Open(_filePath, FileMode.Append))
                using (var writer = new StreamWriter(stream))
                using (var csv = new CsvWriter(writer, config))
                {

                    foreach (var item in _dataSource.ListForImport)
                    {
                        csv.WriteField(item.WorkStart);
                        csv.WriteField(item.WorkEnd);
                        csv.WriteField(item.EmployeeFullName);
                        csv.WriteField(item.WorkDescription);
                        csv.WriteField(item.UM);
                        csv.WriteField(item.TaskQuantityToString);
                        csv.WriteField(item.WorkCost);
                        csv.WriteField(item.WorkQuantityAcceptedToString);
                        csv.WriteField(Math.Round(item.WorkCostSummaryAccepted, 2));
                        csv.WriteField(Math.Round(_dataSource.Cost, 2));
                        csv.NextRecord();
                    }
                }
            }


            {
                string _message = string.Format("Имя файла:\n{0}\nОткрыть файл для просмотра?", fileName);
                string _caption = "Файл импорта сохранён в папке \"Мои документы\"!";
                MessageBoxButtons _buttons = MessageBoxButtons.YesNo;
                DialogResult _result;

                _result = MessageBox.Show(_message, _caption, _buttons,
                    MessageBoxIcon.Question, MessageBoxDefaultButton.Button1);

                if (_result == DialogResult.Yes)
                {
                    Process.Start("notepad.exe", _filePath);
                }
            }
        }
