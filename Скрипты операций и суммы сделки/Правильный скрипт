def get_src_conn():
    return pymssql.connect(
        server=SRC_SERVER,
        port=SRC_PORT,
        user=SRC_USER,
        password=SRC_PASSWORD,
        database=SRC_DATABASE,
        tds_version='7.0'
    )

def get_dst_conn():
    return pymssql.connect(
        server=DST_SERVER,
        user=DST_USER,
        password=DST_PASSWORD,
        database=DST_DATABASE,
        charset='UTF-8'  # ← Поддержка кириллицы
    )

def load_shtraf_smart():
    print("🔄 Умная дельта-загрузка Shtraf_Edit")
    src = get_src_conn()
    dst = get_dst_conn()

    # Получаем время последней загрузки из etl_load_state
    dst_cursor = dst.cursor()
    dst_cursor.execute("""
        SELECT last_delta_run 
        FROM etl_load_state 
        WHERE base_table_name = 'Shtraf_Edit' AND table_group = 'ref'
    """)
    row = dst_cursor.fetchone()
    last_run = row[0] if row and row[0] else datetime(2024, 1, 1)
    print(f"   ⏱️ Последняя загрузка: {last_run}")

    # Колонки (с учётом зарезервированных слов)
    columns = [
        "id", "date_time_stamp", "user", "reference_id", "out",
        "item", "straf_id", "author", "name", "price", "comment", "confirmed"
    ]
    column_list = ", ".join([f"[{col}]" if col in ('user', 'out') else col for col in columns])

    try:
        # Загружаем только новые/изменённые записи
        src_cursor = src.cursor()
        src_cursor.execute(f"""
            SELECT {column_list} 
            FROM Shtraf_Edit 
            WHERE date_time_stamp > %s
        """, (last_run,))
        rows = src_cursor.fetchall()
        print(f"   → Найдено {len(rows)} новых/изменённых строк")

        if rows:
            # Удаляем старые версии по id (уникальный ключ)
            ids = [row[0] for row in rows]  # id = первая колонка
            placeholders = ",".join(["%s"] * len(ids))
            dst_cursor.execute(f"DELETE FROM raw_.Shtraf_Edit WHERE id IN ({placeholders})", ids)
            dst.commit()

            # Вставляем новые версии
            placeholders = ",".join(["%s"] * len(columns))
            insert_sql = f"INSERT INTO raw_.Shtraf_Edit ({column_list}) VALUES ({placeholders})"
            dst_cursor.executemany(insert_sql, rows)
            dst.commit()
            print(f"   ✅ Записано {len(rows)} строк")

        # Обновляем last_delta_run ТОЛЬКО после успешной загрузки
        now = datetime.now()
        dst_cursor.execute("""
            UPDATE etl_load_state 
            SET last_delta_run = %s 
            WHERE base_table_name = 'Shtraf_Edit' AND table_group = 'ref'
        """, (now,))
        dst.commit()
        print(f"   💾 Обновлено last_delta_run = {now}")

    finally:
        src.close()
        dst.close()

def main():
    print("=== УМНАЯ ДЕЛЬТА-ЗАГРУЗКА ШТРАФОВ ===")
    load_shtraf_smart()
    print("🏁 Готово")

if __name__ == "__main__":
    main()