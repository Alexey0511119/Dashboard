DROP VIEW IF EXISTS dm.v_employee_modal_detail;
GO

CREATE VIEW dm.v_employee_modal_detail AS
WITH employee_daily_bounds AS (
    SELECT
        employee_id,
        date_key,
        MIN(start_time) AS work_start,
        MAX(end_time) AS work_end
    FROM dwh.fact_operation
    GROUP BY employee_id, date_key
),
all_operations_sorted AS (
    SELECT
        f.employee_id,
        f.date_key,
        f.start_time,
        f.end_time,
        ROW_NUMBER() OVER (
            PARTITION BY f.employee_id, f.date_key 
            ORDER BY f.start_time
        ) AS rn
    FROM dwh.fact_operation f
),
idle_gaps AS (
    SELECT
        curr.employee_id,
        curr.date_key,
        DATEDIFF(MINUTE, curr.end_time, next_op.start_time) AS gap_minutes
    FROM all_operations_sorted curr
    JOIN all_operations_sorted next_op 
        ON curr.employee_id = next_op.employee_id
       AND curr.date_key = next_op.date_key
       AND curr.rn + 1 = next_op.rn
    WHERE DATEDIFF(MINUTE, curr.end_time, next_op.start_time) >= 5
),
idle_summary AS (
    SELECT
        employee_id,
        date_key,
        SUM(gap_minutes) AS total_idle_minutes,
        SUM(CASE WHEN gap_minutes >= 5  AND gap_minutes < 10  THEN 1 ELSE 0 END) AS idle_5_10,
        SUM(CASE WHEN gap_minutes >= 10 AND gap_minutes < 30 THEN 1 ELSE 0 END) AS idle_10_30,
        SUM(CASE WHEN gap_minutes >= 30 AND gap_minutes < 60 THEN 1 ELSE 0 END) AS idle_30_60,
        SUM(CASE WHEN gap_minutes >= 60 THEN 1 ELSE 0 END) AS idle_60plus
    FROM idle_gaps
    GROUP BY employee_id, date_key
),
ops_by_type AS (
    SELECT
        f.employee_id,
        e.fio,
        f.date_key,
        wt.work_type_name AS operation_type,
        COUNT(*) AS operation_count,
        AVG(CAST(f.duration_sec AS FLOAT)) / 60.0 AS avg_time_minutes
    FROM dwh.fact_operation f
    JOIN dm.dim_employee e ON f.employee_id = e.employee_id
    JOIN dm.dim_work_type wt ON f.work_type_id = wt.work_type_id
    WHERE f.source_system = 'WMS'
    GROUP BY f.employee_id, e.fio, f.date_key, wt.work_type_name
),
reception_summary AS (
    SELECT
        f.employee_id,
        f.date_key,
        COUNT(*) AS reception_count
    FROM dwh.fact_operation f
    WHERE f.source_system = 'TRANSACTION'
    GROUP BY f.employee_id, f.date_key
),
orders_summary AS (
    SELECT
        o.fio,
        o.date,
        COUNT(DISTINCT o.SHIPMENT_ID) AS orders_completed,
        CAST(SUM(CASE WHEN o.timeliness_status = 'Вовремя' THEN 1 ELSE 0 END) * 100.0 /
             NULLIF(COUNT(*), 0) AS DECIMAL(5,2)) AS timely_percentage
    FROM dwh.orders_enriched o
    GROUP BY o.fio, o.date
),
fines_summary AS (
    SELECT
        p.employee_id,
        p.date_key,
        COUNT(*) AS fines_count,
        SUM(p.fine_amount) AS fines_amount
    FROM dwh.fact_penalty p
    GROUP BY p.employee_id, p.date_key
)
SELECT
    e.fio,
    e.smena,
    COALESCE(o.date_key, rec.date_key, fin.date_key, idle.date_key) AS date_key,
    COALESCE(o.total_operations, 0) AS total_operations,
    COALESCE(o.total_earnings, 0) AS total_earnings,
    COALESCE(idle.total_idle_minutes, 0) AS total_idle_minutes,
    COALESCE(idle.idle_5_10, 0) AS idle_5_10,
    COALESCE(idle.idle_10_30, 0) AS idle_10_30,
    COALESCE(idle.idle_30_60, 0) AS idle_30_60,
    COALESCE(idle.idle_60plus, 0) AS idle_60plus,
    COALESCE(ord.orders_completed, 0) AS orders_completed,
    COALESCE(ord.timely_percentage, 100.0) AS timely_percentage,
    COALESCE(fin.fines_count, 0) AS fines_count,
    COALESCE(fin.fines_amount, 0) AS fines_amount,
    STRING_AGG(
        CONCAT(ot.operation_type, ': ', ot.operation_count, ' (ср. ', ROUND(ot.avg_time_minutes, 1), ' мин)'),
        '; '
    ) WITHIN GROUP (ORDER BY ot.operation_count DESC) AS operations_by_type,
    COALESCE(rec.reception_count, 0) AS reception_count
FROM dm.dim_employee e
LEFT JOIN (
    SELECT employee_id, date_key, COUNT(*) AS total_operations, SUM(price_per_op) AS total_earnings
    FROM dwh.fact_operation
    GROUP BY employee_id, date_key
) o ON e.employee_id = o.employee_id
LEFT JOIN ops_by_type ot ON e.employee_id = ot.employee_id AND o.date_key = ot.date_key
LEFT JOIN reception_summary rec ON e.employee_id = rec.employee_id AND o.date_key = rec.date_key
LEFT JOIN orders_summary ord ON e.fio = ord.fio AND o.date_key = ord.date
LEFT JOIN fines_summary fin ON e.employee_id = fin.employee_id AND o.date_key = fin.date_key
LEFT JOIN idle_summary idle ON e.employee_id = idle.employee_id AND o.date_key = idle.date_key
WHERE e.is_active = 1
GROUP BY
    e.fio, e.smena, o.date_key, rec.date_key, fin.date_key, idle.date_key,
    o.total_operations, o.total_earnings, idle.total_idle_minutes,
    idle.idle_5_10, idle.idle_10_30, idle.idle_30_60, idle.idle_60plus,
    ord.orders_completed, ord.timely_percentage, fin.fines_count, fin.fines_amount, rec.reception_count;
GO



