DROP VIEW IF EXISTS dm.v_performance_detailed;
GO

CREATE VIEW dm.v_performance_detailed AS
WITH employee_daily_ops AS (
    SELECT
        f.employee_id,
        e.fio,
        e.smena,
        f.date_key,
        MIN(f.start_time) AS first_op_time,
        MAX(f.end_time) AS last_op_time,
        COUNT(*) AS total_operations,
        SUM(CASE WHEN f.source_system = 'WMS' THEN 1 ELSE 0 END) AS wms_operations,
        SUM(CASE WHEN f.source_system = 'TRANSACTION' THEN 1 ELSE 0 END) AS reception_count,
        SUM(ISNULL(f.price_per_op, 0)) AS total_earnings
    FROM dwh.fact_operation f
    JOIN dm.dim_employee e ON f.employee_id = e.employee_id AND e.is_active = 1
    GROUP BY f.employee_id, e.fio, e.smena, f.date_key
),
calculated_metrics AS (
    SELECT
        fio,
        smena,
        date_key,
        first_op_time,
        last_op_time,
        total_operations,
        wms_operations,
        reception_count,
        total_earnings,
        CASE
            WHEN first_op_time IS NOT NULL AND last_op_time IS NOT NULL THEN
                CONCAT(
                    FLOOR(DATEDIFF(SECOND, first_op_time, last_op_time) / 3600.0),
                    'ч ',
                    FLOOR((DATEDIFF(SECOND, first_op_time, last_op_time) % 3600) / 60.0),
                    'м'
                )
            ELSE '--:--'
        END AS work_duration,
        CASE
            WHEN total_operations > 0 AND first_op_time IS NOT NULL AND last_op_time IS NOT NULL THEN
                ROUND(DATEDIFF(MINUTE, first_op_time, last_op_time) * 1.0 / total_operations, 1)
            ELSE 0.0
        END AS avg_time_per_op_minutes,
        CASE
            WHEN total_operations > 0 
                 AND first_op_time IS NOT NULL 
                 AND last_op_time IS NOT NULL 
                 AND DATEDIFF(MINUTE, first_op_time, last_op_time) > 0 THEN
                ROUND(60.0 / (DATEDIFF(MINUTE, first_op_time, last_op_time) * 1.0 / total_operations), 1)
            ELSE 0.0
        END AS ops_per_hour,
        CASE
            WHEN first_op_time IS NOT NULL THEN
                FORMAT(first_op_time, 'HH:mm')
            ELSE '--:--'
        END AS first_op_time_formatted
    FROM employee_daily_ops
)
SELECT
    fio AS Сотрудник,
    date_key,
    total_operations AS Общее_кол_операций,
    avg_time_per_op_minutes AS Ср_время_на_операцию,
    total_earnings AS Заработок,
    ops_per_hour AS Операций_в_час,
    work_duration AS Время_работы,
    first_op_time_formatted AS Время_первой_операции,
    wms_operations AS Обычные_операции,
    reception_count AS Приемка
FROM calculated_metrics
WHERE total_operations > 0;
GO


