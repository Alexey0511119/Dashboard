-- ============================================================================
-- СКРИПТ 1: ОСНОВНОЙ ETL ПРОЦЕСС (ИСПРАВЛЕННЫЙ)
-- Все названия операций приведены к единому виду
-- ============================================================================
USE olap2_fixed;
GO

-- ====== ШАГ 1: Создание схем ======
IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'dwh') EXEC('CREATE SCHEMA dwh');
IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'dm') EXEC('CREATE SCHEMA dm');
GO

-- ====== ШАГ 2: Очистка основных таблиц ======
DROP TABLE IF EXISTS dwh.fact_operation;
DROP TABLE IF EXISTS dwh.fact_penalty;
DROP TABLE IF EXISTS dwh.fact_rejection;
DROP TABLE IF EXISTS dwh.fact_location_snapshot;
DROP TABLE IF EXISTS dm.dim_employee;
DROP TABLE IF EXISTS dm.dim_date;
DROP TABLE IF EXISTS dm.dim_work_type;
DROP TABLE IF EXISTS dwh.orders_enriched;
DROP TABLE IF EXISTS dwh.operations_enriched;
DROP TABLE IF EXISTS dwh.fines_enriched;
DROP TABLE IF EXISTS dwh.cube_shipment_detail;
DROP TABLE IF EXISTS dwh.receipts_status;
DROP TABLE IF EXISTS dwh.placement_cache;
DROP TABLE IF EXISTS dwh.pick_cache;
GO

-- ====== ШАГ 3: dim_date ======
CREATE TABLE dm.dim_date (
    date_key DATE NOT NULL PRIMARY KEY,
    year SMALLINT NOT NULL,
    quarter TINYINT NOT NULL,
    month TINYINT NOT NULL,
    month_name NVARCHAR(10) NOT NULL,
    day TINYINT NOT NULL,
    day_of_week TINYINT NOT NULL,
    day_of_week_name NVARCHAR(10) NOT NULL,
    is_weekend BIT NOT NULL,
    is_working_day BIT NOT NULL,
    week_number TINYINT NOT NULL,
    year_month CHAR(7) NOT NULL
);

WITH DateSeries AS (
    SELECT CAST('2020-01-01' AS DATE) AS date_value
    UNION ALL
    SELECT DATEADD(DAY, 1, date_value)
    FROM DateSeries
    WHERE date_value < '2028-12-31'
)
INSERT INTO dm.dim_date
SELECT
    date_value,
    YEAR(date_value),
    DATEPART(QUARTER, date_value),
    MONTH(date_value),
    DATENAME(MONTH, date_value),
    DAY(date_value),
    DATEPART(WEEKDAY, date_value),
    DATENAME(WEEKDAY, date_value),
    CASE WHEN DATEPART(WEEKDAY, date_value) IN (1,7) THEN 1 ELSE 0 END,
    CASE WHEN DATEPART(WEEKDAY, date_value) NOT IN (1,7) THEN 1 ELSE 0 END,
    DATEPART(WEEK, date_value),
    FORMAT(date_value, 'yyyy-MM')
FROM DateSeries
OPTION (MAXRECURSION 0);
GO

-- ====== ШАГ 4: Материализация для группировки ======
-- Размещения
SELECT
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_ID,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_TYPE,
    CAST(NULL AS NVARCHAR(100)) AS WORK_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS TO_LOC,
    CAST(NULL AS NVARCHAR(100)) AS COMPLETED_BY_USER,
    CAST(NULL AS DATETIME2) AS START_DATE_TIME,
    CAST(NULL AS DATETIME2) AS END_DATE_TIME
INTO dwh.placement_cache
WHERE 1 = 0;

INSERT INTO dwh.placement_cache
SELECT
    REFERENCE_ID,
    REFERENCE_TYPE,
    WORK_TYPE,
    ITEM,
    TO_LOC,
    COMPLETED_BY_USER,
    START_DATE_TIME,
    END_DATE_TIME
FROM raw_.WORK_INSTRUCTION_VIEW2
WHERE
    INSTRUCTION_TYPE = 'Detail'
    AND CONDITION = 'closed'
    AND WORK_TYPE LIKE N'Размещение%'
    AND START_DATE_TIME IS NOT NULL
    AND END_DATE_TIME IS NOT NULL;

-- Сложные отборы (ИСПРАВЛЕНО: "компл" → "комп")
SELECT
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_ID,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_TYPE,
    CAST(NULL AS NVARCHAR(100)) AS WORK_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS PARENT_INSTR,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS FROM_LOC,
    CAST(NULL AS NVARCHAR(100)) AS COMPLETED_BY_USER,
    CAST(NULL AS DATETIME2) AS START_DATE_TIME,
    CAST(NULL AS DATETIME2) AS END_DATE_TIME
INTO dwh.pick_cache
WHERE 1 = 0;

INSERT INTO dwh.pick_cache
SELECT
    REFERENCE_ID,
    REFERENCE_TYPE,
    WORK_TYPE,
    PARENT_INSTR,
    ITEM,
    FROM_LOC,
    COMPLETED_BY_USER,
    START_DATE_TIME,
    END_DATE_TIME
FROM raw_.WORK_INSTRUCTION_VIEW2
WHERE
    INSTRUCTION_TYPE = 'Detail'
    AND CONDITION = 'closed'
    AND WORK_TYPE IN (
        N'Отбор ME', N'Отбор ZX 10-20', N'Отбор ZX 30-50', N'Отбор ZX 30-50 комп',
        N'Отбор ZX КПП', N'Отбор негабарит', N'Отбор транзит',
        N'Отбор WH2 ZX 10-20', N'Отбор WH2 ZX 30-50', N'Отбор WH2 ME', N'Отбор WH2 негабарит'
    )
    AND START_DATE_TIME IS NOT NULL
    AND END_DATE_TIME IS NOT NULL;
GO

-- ====== ШАГ 5: operations_enriched ======
SELECT
    w.REFERENCE_ID,
    w.REFERENCE_TYPE,
    w.WORK_TYPE,
    w.ITEM,
    w.TO_LOC,
    w.COMPLETED_BY_USER AS user_name,
    w.START_DATE_TIME,
    w.END_DATE_TIME,
    DATEDIFF(SECOND, w.START_DATE_TIME, w.END_DATE_TIME) AS duration_sec,
    CASE
        WHEN w.WORK_TYPE = N'Отбор KSP' AND i.user_def1 = N'AABL' THEN 110.40
        WHEN w.WORK_TYPE = N'Отбор KSP' AND (i.user_def1 <> N'AABL' OR i.user_def1 IS NULL) THEN 62.80
        WHEN w.WORK_TYPE = N'Отбор KP' THEN 62.80
        WHEN w.WORK_TYPE = N'Перемещение на КС' THEN 15.40
        ELSE p.price
    END AS price_per_op,
    CAST(w.START_DATE_TIME AS DATE) AS date,
    u.fio,
    u.smena,
    u.position
INTO dwh.operations_enriched
FROM raw_.WORK_INSTRUCTION_VIEW2 w
LEFT JOIN raw_.USER_CADR_EDIT u
    ON w.COMPLETED_BY_USER COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
LEFT JOIN raw_.ITEM i
    ON w.ITEM COLLATE Cyrillic_General_100_CI_AS = i.ITEM COLLATE Cyrillic_General_100_CI_AS
LEFT JOIN raw_.Sdelka_price p
    ON w.WORK_TYPE COLLATE Cyrillic_General_100_CI_AS = p.work_type COLLATE Cyrillic_General_100_CI_AS
WHERE
    w.INSTRUCTION_TYPE = 'Detail'
    AND w.CONDITION = 'closed'
    AND w.START_DATE_TIME IS NOT NULL
    AND w.END_DATE_TIME IS NOT NULL
    AND u.smena IN ('1', '2');

-- Приёмка
INSERT INTO dwh.operations_enriched
SELECT
    NULL AS REFERENCE_ID,
    'Приемка' AS REFERENCE_TYPE,
    'Приемка' AS WORK_TYPE,
    NULL AS ITEM,
    NULL AS TO_LOC,
    t.USER_NAME AS user_name,
    t.event_time AS START_DATE_TIME,
    DATEADD(SECOND, 60, t.event_time) AS END_DATE_TIME,
    60 AS duration_sec,
    18.70 AS price_per_op,
    t.date_key AS date,
    u.fio,
    u.smena,
    u.position
FROM dwh.transaction_events t
JOIN raw_.USER_CADR_EDIT u
    ON t.USER_NAME COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE u.smena IN ('1', '2');

-- Перемер ZX KPP
INSERT INTO dwh.operations_enriched
SELECT
    NULL AS REFERENCE_ID,
    'Перемер ZX KPP' AS REFERENCE_TYPE,
    'Перемер ZX KPP' AS WORK_TYPE,
    NULL AS ITEM,
    NULL AS TO_LOC,
    p.user_name,
    p.date_time_stamp AS START_DATE_TIME,
    DATEADD(SECOND, 60, p.date_time_stamp) AS END_DATE_TIME,
    60 AS duration_sec,
    52.30 AS price_per_op,
    CAST(p.date_time_stamp AS DATE) AS date,
    u.fio,
    u.smena,
    u.position
FROM raw_.eks_peremer_ZX_KPP p
JOIN raw_.USER_CADR_EDIT u
    ON p.user_name COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE u.smena IN ('1', '2')
    AND p.date_time_stamp IS NOT NULL;

-- Перемер с прихода
WITH peremer_prihoda AS (
    SELECT
        UPPER(uc.USER_DEF6) AS user_name,
        urh.DATE_TIME_STAMP
    FROM raw_.UPLOAD_RECEIPT_HEADER urh
    JOIN raw_.UPLOAD_RECEIPT_CONTAINER uc
        ON urh.INTERFACE_RECORD_ID = uc.INTERFACE_LINK_ID
    JOIN raw_.ITEM i ON uc.ITEM = i.ITEM
    WHERE
        urh.INTERFACE_CONDITION = 'End'
        AND urh.DATE_TIME_STAMP IS NOT NULL
        AND i.ITEM_CATEGORY1 = '1'
        AND uc.USER_DEF6 IS NOT NULL
        AND uc.RECEIPT_ID NOT IN (
            SELECT uc2.CONTAINER_ID
            FROM raw_.UPLOAD_RECEIPT_HEADER urh2
            JOIN raw_.UPLOAD_RECEIPT_CONTAINER uc2 ON urh2.INTERFACE_RECORD_ID = uc2.INTERFACE_LINK_ID
            JOIN raw_.UPLOAD_RECEIPT_CONTAINER uc1 ON uc2.INTERNAL_REC_CONT_NUM = uc1.Parent
            WHERE urh2.INTERFACE_CONDITION = 'End'
            AND uc1.INTERFACE_CONDITION = 'End'
        )
)
INSERT INTO dwh.operations_enriched
SELECT
    NULL AS REFERENCE_ID,
    'Перемер с прихода' AS REFERENCE_TYPE,
    'Перемер с прихода' AS WORK_TYPE,
    NULL AS ITEM,
    NULL AS TO_LOC,
    p.user_name,
    p.DATE_TIME_STAMP AS START_DATE_TIME,
    DATEADD(SECOND, 60, p.DATE_TIME_STAMP) AS END_DATE_TIME,
    60 AS duration_sec,
    17.00 AS price_per_op,
    CAST(p.DATE_TIME_STAMP AS DATE) AS date,
    u.fio,
    u.smena,
    u.position
FROM peremer_prihoda p
JOIN raw_.USER_CADR_EDIT u
    ON p.user_name COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE u.smena IN ('1', '2');

-- Грузчики (уже рассчитаны в raw_.gruz_operations)
WITH gruz_with_time AS (
    SELECT
        g.user_name,
        g.date_key,
        MIN(lm.date_time_stamp) AS min_time,
        MAX(lm.date_time_stamp) AS max_time,
        g.[Разгрузка механизмами],
        g.[Разгрузка ручная],
        g.[Загрузка механизмами],
        g.[Загрузка ручная]
    FROM raw_.gruz_operations g
    JOIN raw_.labor_management lm
        ON g.user_name COLLATE Cyrillic_General_100_CI_AS = lm.user_name COLLATE Cyrillic_General_100_CI_AS
        AND CAST(lm.date_time_stamp AS DATE) = g.date_key
    WHERE
        g.[Разгрузка механизмами] > 0 OR
        g.[Разгрузка ручная] > 0 OR
        g.[Загрузка механизмами] > 0 OR
        g.[Загрузка ручная] > 0
    GROUP BY
        g.user_name,
        g.date_key,
        g.[Разгрузка механизмами],
        g.[Разгрузка ручная],
        g.[Загрузка механизмами],
        g.[Загрузка ручная]
)
INSERT INTO dwh.operations_enriched
SELECT
    NULL AS REFERENCE_ID,
    gu.work_type AS REFERENCE_TYPE,
    gu.work_type AS WORK_TYPE,
    NULL AS ITEM,
    NULL AS TO_LOC,
    gu.user_name,
    gu.min_time AS START_DATE_TIME,
    gu.max_time AS END_DATE_TIME,
    DATEDIFF(SECOND, gu.min_time, gu.max_time) AS duration_sec,
    gu.price AS price_per_op,
    gu.date_key AS date,
    u.fio,
    u.smena,
    u.position
FROM (
    SELECT
        user_name,
        date_key,
        min_time,
        max_time,
        'Разгрузка механизмами' AS work_type,
        [Разгрузка механизмами] * 22.50 AS price
    FROM gruz_with_time WHERE [Разгрузка механизмами] > 0
    UNION ALL
    SELECT
        user_name,
        date_key,
        min_time,
        max_time,
        'Разгрузка ручная' AS work_type,
        [Разгрузка ручная] * 22.50 AS price
    FROM gruz_with_time WHERE [Разгрузка ручная] > 0
    UNION ALL
    SELECT
        user_name,
        date_key,
        min_time,
        max_time,
        'Загрузка механизмами' AS work_type,
        [Загрузка механизмами] * 68.40 AS price
    FROM gruz_with_time WHERE [Загрузка механизмами] > 0
    UNION ALL
    SELECT
        user_name,
        date_key,
        min_time,
        max_time,
        'Загрузка ручная' AS work_type,
        [Загрузка ручная] * 68.40 AS price
    FROM gruz_with_time WHERE [Загрузка ручная] > 0
) gu
JOIN raw_.USER_CADR_EDIT u
    ON gu.user_name COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE u.smena IN ('1', '2');
GO

-- ====== ШАГ 6: Остальные таблицы ======
-- orders_enriched
SELECT
    s.SHIPMENT_ID,
    s.ORDER_TYPE,
    s.STOP,
    s.ERP_ORDER,
    s.ROUTING_CODE,
    o.user_name,
    u.fio,
    u.smena,
    o.START_DATE_TIME,
    o.END_DATE_TIME,
    o.duration_sec,
    CASE
        WHEN o.END_DATE_TIME <= TRY_CAST(s.STOP AS DATETIME2(0)) THEN 'Вовремя'
        ELSE 'Просрочено'
    END AS timeliness_status,
    TRY_CAST(o.START_DATE_TIME AS DATE) AS date
INTO dwh.orders_enriched
FROM raw_.SHIPMENT_HEADER s
JOIN dwh.operations_enriched o
    ON s.SHIPMENT_ID COLLATE Cyrillic_General_100_CI_AS = o.REFERENCE_ID COLLATE Cyrillic_General_100_CI_AS
LEFT JOIN raw_.USER_CADR_EDIT u
    ON o.user_name COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
WHERE
    s.STOP IS NOT NULL
    AND o.START_DATE_TIME IS NOT NULL
    AND o.END_DATE_TIME IS NOT NULL
    AND o.REFERENCE_TYPE IN ('Клиент', 'Филиал', 'Ювелс');

-- fines_enriched
SELECT
    TRY_CAST(f.date_time_stamp AS DATETIME2(0)) AS date_time_stamp,
    f.[user] AS user_name,
    f.reference_id,
    f.name AS fine_category,
    CAST(f.price AS DECIMAL(18,2)) AS fine_amount,
    f.comment,
    u.fio,
    u.smena,
    TRY_CAST(f.date_time_stamp AS DATE) AS date
INTO dwh.fines_enriched
FROM raw_.Shtraf_Edit f
LEFT JOIN raw_.USER_CADR_EDIT u
    ON f.[user] COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE
    f.date_time_stamp IS NOT NULL
    AND f.[user] IS NOT NULL
    AND u.smena IN ('1', '2');

-- cube_shipment_detail
SELECT
    SHIPMENT_ID,
    ITEM,
    ITEM_DESC,
    REQUESTED_QTY,
    QUANTITY_UM,
    PICK_LOC,
    PICK_ZONE,
    TRY_CAST(DATE_TIME_STAMP AS DATETIME2(0)) AS DATE_TIME_STAMP
INTO dwh.cube_shipment_detail
FROM raw_.SHIPMENT_DETAIL
WHERE
    STATUS1 = '900'
    AND DATE_TIME_STAMP IS NOT NULL;

-- receipts_status
WITH headers AS (
    SELECT
        RECEIPT_ID,
        MIN(CAST(CREATION_DATE_TIME_STAMP AS DATETIME2(0))) AS date_created,
        MAX(CAST(CLOSE_DATE AS DATETIME2(0))) AS date_closed,
        MAX(RECEIPT_TYPE) AS receipt_type,
        CAST(MIN(CAST(CREATION_DATE_TIME_STAMP AS DATETIME2(0))) AS DATE) AS date_key
    FROM raw_.UPLOAD_RECEIPT_HEADER
    WHERE CREATION_DATE_TIME_STAMP IS NOT NULL
    GROUP BY RECEIPT_ID
),
details AS (
    SELECT
        RECEIPT_ID,
        MIN(CASE WHEN INTERFACE_CONDITION = 'End' THEN CAST(DATE_TIME_STAMP AS DATETIME2(0)) END) AS date_started,
        COUNT(*) AS items_total,
        COUNT(CASE WHEN INTERFACE_CONDITION = 'End' THEN 1 END) AS items_completed
    FROM raw_.UPLOAD_RECEIPT_DETAIL
    WHERE RECEIPT_ID IS NOT NULL AND DATE_TIME_STAMP IS NOT NULL
    GROUP BY RECEIPT_ID
)
SELECT
    h.RECEIPT_ID,
    h.receipt_type,
    h.date_created,
    d.date_started,
    h.date_closed,
    DATEADD(HOUR, 24, h.date_created) AS deadline,
    h.date_key,
    COALESCE(d.items_total, 0) AS items_total,
    COALESCE(d.items_completed, 0) AS items_completed,
    CASE
        WHEN h.date_closed IS NOT NULL THEN
            CASE WHEN h.date_closed <= DATEADD(HOUR, 24, h.date_created) THEN '✅ Сделано вовремя' ELSE '❌ Просрочено' END
        WHEN d.items_completed > 0 THEN '🛠 В работе'
        WHEN d.items_completed = 0 OR d.items_completed IS NULL THEN
            CASE
                WHEN GETDATE() >= DATEADD(HOUR, 24, h.date_created) THEN '🔴 Просрочена (не начата)'
                WHEN GETDATE() >= DATEADD(HOUR, 22, h.date_created) THEN '⚠️ Просрочится через ≤2 часа'
                ELSE '⏳ Ожидает приёма'
            END
        ELSE 'Неизвестно'
    END AS status
INTO dwh.receipts_status
FROM headers h
LEFT JOIN details d ON h.RECEIPT_ID = d.RECEIPT_ID
WHERE h.date_created IS NOT NULL;

-- dim_employee
CREATE TABLE dm.dim_employee (
    employee_id INT IDENTITY(1,1) PRIMARY KEY,
    user_name NVARCHAR(100) NOT NULL,
    fio NVARCHAR(200) NOT NULL,
    smena NVARCHAR(30) NOT NULL,
    brigada NVARCHAR(100) NOT NULL,
    position NVARCHAR(100) NULL,
    is_active BIT NOT NULL,
    valid_from DATE NOT NULL,
    valid_to DATE NOT NULL DEFAULT '2099-12-31'
);

INSERT INTO dm.dim_employee (user_name, fio, smena, brigada, position, is_active, valid_from)
SELECT DISTINCT
    user_name,
    fio,
    smena,
    brigada,
    position,
    CASE WHEN deleted = 0 THEN 1 ELSE 0 END,
    CAST(GETDATE() AS DATE)
FROM raw_.USER_CADR_EDIT
WHERE user_name IS NOT NULL AND fio IS NOT NULL AND smena IN ('1', '2');

-- dim_work_type
CREATE TABLE dm.dim_work_type (
    work_type_id INT IDENTITY(1,1) PRIMARY KEY,
    work_type_name NVARCHAR(100) NOT NULL,
    work_category NVARCHAR(50) NOT NULL,
    complexity_level TINYINT NOT NULL
);

INSERT INTO dm.dim_work_type (work_type_name, work_category, complexity_level)
SELECT DISTINCT
    work_type,
    CASE
        WHEN work_type LIKE '%Ревизия%' THEN 'Ревизия'
        WHEN work_type LIKE '%Размещение%' THEN 'Размещение'
        WHEN work_type LIKE '%Отбор%' THEN 'Отбор'
        WHEN work_type LIKE '%Прием%' THEN 'Приемка'
        WHEN work_type LIKE '%Перемещение%' THEN 'Перемещение'
        WHEN work_type LIKE '%Пополнение%' THEN 'Пополнение'
        WHEN work_type LIKE '%Погрузка%' THEN 'Погрузка'
        WHEN work_type LIKE '%Накопление%' THEN 'Накопление'
        WHEN work_type LIKE '%Трансферт%' THEN 'Трансферт'
        ELSE 'Прочее'
    END,
    CASE
        WHEN work_type LIKE '%Ревизия%' THEN 3
        WHEN work_type LIKE '%Размещение%' THEN 2
        WHEN work_type LIKE '%Отбор%' THEN 2
        ELSE 1
    END
FROM dwh.operations_enriched
WHERE work_type IS NOT NULL;

-- Добавляем недостающие типы работ
IF NOT EXISTS (SELECT 1 FROM dm.dim_work_type WHERE work_type_name = 'Приемка')
    INSERT INTO dm.dim_work_type VALUES ('Приемка', 'Приемка', 1);
IF NOT EXISTS (SELECT 1 FROM dm.dim_work_type WHERE work_type_name = 'Перемер ZX KPP')
    INSERT INTO dm.dim_work_type VALUES ('Перемер ZX KPP', 'Перемер', 2);
IF NOT EXISTS (SELECT 1 FROM dm.dim_work_type WHERE work_type_name = 'Перемер с прихода')
    INSERT INTO dm.dim_work_type VALUES ('Перемер с прихода', 'Перемер', 2);

-- Добавляем все типы Размещений и сложных Отборов
INSERT INTO dm.dim_work_type (work_type_name, work_category, complexity_level)
SELECT DISTINCT
    w.WORK_TYPE,
    CASE WHEN w.WORK_TYPE LIKE N'Размещение%' THEN 'Размещение' ELSE 'Отбор' END,
    2
FROM (
    SELECT WORK_TYPE FROM dwh.placement_cache
    UNION
    SELECT WORK_TYPE FROM dwh.pick_cache
) w
WHERE NOT EXISTS (
    SELECT 1 FROM dm.dim_work_type dt WHERE dt.work_type_name = w.WORK_TYPE
);

-- fact_operation
CREATE TABLE dwh.fact_operation (
    date_key DATE NOT NULL,
    employee_id INT NOT NULL,
    work_type_id INT NOT NULL,
    reference_id NVARCHAR(25) NULL,
    reference_type NVARCHAR(25) NULL,
    start_time DATETIME2(0) NOT NULL,
    end_time DATETIME2(0) NOT NULL,
    duration_sec INT NOT NULL,
    price_per_op DECIMAL(18,2) NULL,
    is_order BIT NOT NULL,
    source_system NVARCHAR(20) NOT NULL
);

ALTER TABLE dwh.fact_operation ADD CONSTRAINT FK_fact_operation_date FOREIGN KEY (date_key) REFERENCES dm.dim_date(date_key);
ALTER TABLE dwh.fact_operation ADD CONSTRAINT FK_fact_operation_employee FOREIGN KEY (employee_id) REFERENCES dm.dim_employee(employee_id);
ALTER TABLE dwh.fact_operation ADD CONSTRAINT FK_fact_operation_work_type FOREIGN KEY (work_type_id) REFERENCES dm.dim_work_type(work_type_id);

-- Простые операции (ИСПРАВЛЕНО: "компл" → "комп", "KC" → "КС")
INSERT INTO dwh.fact_operation
SELECT
    CAST(o.START_DATE_TIME AS DATE),
    e.employee_id,
    wt.work_type_id,
    o.REFERENCE_ID,
    o.REFERENCE_TYPE,
    o.START_DATE_TIME,
    o.END_DATE_TIME,
    o.duration_sec,
    o.price_per_op,
    CASE WHEN o.REFERENCE_TYPE IN ('Клиент', 'Филиал', 'Ювелс') THEN 1 ELSE 0 END,
    'WMS'
FROM dwh.operations_enriched o
JOIN dm.dim_employee e
    ON o.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
    AND e.is_active = 1
JOIN dm.dim_work_type wt
    ON o.WORK_TYPE COLLATE Cyrillic_General_100_CI_AS = wt.work_type_name COLLATE Cyrillic_General_100_CI_AS
WHERE o.WORK_TYPE NOT IN (
    N'Отбор ME', N'Отбор ZX 10-20', N'Отбор ZX 30-50', N'Отбор ZX 30-50 комп',
    N'Отбор ZX КПП', N'Отбор негабарит', N'Отбор транзит',
    N'Отбор WH2 ZX 10-20', N'Отбор WH2 ZX 30-50', N'Отбор WH2 ME', N'Отбор WH2 негабарит',
    N'Размещение ME', N'Размещение ZX 10-15', N'Размещение ZX 20-50', N'Размещение КС',
    N'Размещение NG', N'Размещение WH2', N'Размещение брака/боя', N'Размещение транзит',
    N'Размещение ZX КПП'
);

-- === СЛОЖНЫЕ ОТБОРЫ ===
SELECT
    CAST(NULL AS NVARCHAR(50)) AS PARENT_INSTR,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS FROM_LOC,
    CAST(NULL AS DATETIME2) AS max_end_time
INTO #pick_groups
WHERE 1 = 0;

INSERT INTO #pick_groups
SELECT
    PARENT_INSTR,
    ITEM,
    FROM_LOC,
    MAX(END_DATE_TIME) AS max_end_time
FROM dwh.pick_cache
GROUP BY PARENT_INSTR, ITEM, FROM_LOC;

SELECT
    CAST(NULL AS NVARCHAR(100)) AS WORK_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_ID,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS PARENT_INSTR,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS FROM_LOC,
    CAST(NULL AS NVARCHAR(100)) AS COMPLETED_BY_USER,
    CAST(NULL AS DATETIME2) AS start_time,
    CAST(NULL AS DATETIME2) AS end_time,
    CAST(0 AS INT) AS duration_sec,
    CAST(0.0 AS DECIMAL(18,2)) AS price_per_op
INTO #pick_final
WHERE 1 = 0;

INSERT INTO #pick_final
SELECT
    r.WORK_TYPE,
    r.REFERENCE_ID,
    r.REFERENCE_TYPE,
    r.PARENT_INSTR,
    r.ITEM,
    r.FROM_LOC,
    r.COMPLETED_BY_USER,
    MIN(r.START_DATE_TIME) AS start_time,
    g.max_end_time AS end_time,
    DATEDIFF(SECOND, MIN(r.START_DATE_TIME), g.max_end_time) AS duration_sec,
    CASE
        WHEN r.WORK_TYPE = N'Отбор ME' THEN 7.60
        WHEN r.WORK_TYPE = N'Отбор ZX 10-20' THEN 10.10
        WHEN r.WORK_TYPE = N'Отбор ZX 30-50' THEN 14.50
        WHEN r.WORK_TYPE = N'Отбор ZX 30-50 комп' THEN 25.10
        WHEN r.WORK_TYPE = N'Отбор ZX КПП' THEN 20.40
        WHEN r.WORK_TYPE = N'Отбор негабарит' THEN 21.50
        WHEN r.WORK_TYPE = N'Отбор транзит' THEN 21.50
        WHEN r.WORK_TYPE = N'Отбор WH2 ZX 10-20' THEN 3.60
        WHEN r.WORK_TYPE = N'Отбор WH2 ZX 30-50' THEN 4.60
        WHEN r.WORK_TYPE = N'Отбор WH2 ME' THEN 2.60
        WHEN r.WORK_TYPE = N'Отбор WH2 негабарит' THEN 5.40
        ELSE 0.00
    END AS price_per_op
FROM #pick_groups g
JOIN dwh.pick_cache r
    ON g.PARENT_INSTR = r.PARENT_INSTR
    AND g.ITEM = r.ITEM
    AND g.FROM_LOC = r.FROM_LOC
    AND g.max_end_time = r.END_DATE_TIME
GROUP BY
    r.WORK_TYPE,
    r.REFERENCE_ID,
    r.REFERENCE_TYPE,
    r.PARENT_INSTR,
    r.ITEM,
    r.FROM_LOC,
    r.COMPLETED_BY_USER,
    g.max_end_time;

INSERT INTO dwh.fact_operation
SELECT
    CAST(p.start_time AS DATE),
    e.employee_id,
    wt.work_type_id,
    p.REFERENCE_ID,
    p.REFERENCE_TYPE,
    p.start_time,
    p.end_time,
    p.duration_sec,
    p.price_per_op,
    CASE WHEN p.REFERENCE_TYPE IN ('Клиент', 'Филиал', 'Ювелс') THEN 1 ELSE 0 END,
    'WMS'
FROM #pick_final p
JOIN dm.dim_employee e
    ON p.COMPLETED_BY_USER COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
    AND e.is_active = 1
JOIN dm.dim_work_type wt
    ON p.WORK_TYPE COLLATE Cyrillic_General_100_CI_AS = wt.work_type_name COLLATE Cyrillic_General_100_CI_AS;

-- === РАЗМЕЩЕНИЯ (ИСПРАВЛЕНО: "KC" → "КС") ===
SELECT
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_ID,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS TO_LOC,
    CAST(NULL AS DATETIME2) AS max_end_time
INTO #placement_groups
WHERE 1 = 0;

INSERT INTO #placement_groups
SELECT
    REFERENCE_ID,
    REFERENCE_TYPE,
    ITEM,
    TO_LOC,
    MAX(END_DATE_TIME) AS max_end_time
FROM dwh.placement_cache
GROUP BY REFERENCE_ID, REFERENCE_TYPE, ITEM, TO_LOC;

SELECT
    CAST(NULL AS NVARCHAR(100)) AS WORK_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_ID,
    CAST(NULL AS NVARCHAR(50)) AS REFERENCE_TYPE,
    CAST(NULL AS NVARCHAR(50)) AS ITEM,
    CAST(NULL AS NVARCHAR(50)) AS TO_LOC,
    CAST(NULL AS NVARCHAR(100)) AS COMPLETED_BY_USER,
    CAST(NULL AS DATETIME2) AS start_time,
    CAST(NULL AS DATETIME2) AS end_time,
    CAST(0 AS INT) AS duration_sec,
    CAST(0.0 AS DECIMAL(18,2)) AS price_per_op
INTO #placement_final
WHERE 1 = 0;

INSERT INTO #placement_final
SELECT
    r.WORK_TYPE,
    g.REFERENCE_ID,
    g.REFERENCE_TYPE,
    g.ITEM,
    g.TO_LOC,
    r.COMPLETED_BY_USER,
    MIN(r.START_DATE_TIME) AS start_time,
    g.max_end_time AS end_time,
    DATEDIFF(SECOND, MIN(r.START_DATE_TIME), g.max_end_time) AS duration_sec,
    CASE
        WHEN r.WORK_TYPE = N'Размещение ME' THEN 8.10
        WHEN r.WORK_TYPE = N'Размещение ZX 10-15' THEN 19.00
        WHEN r.WORK_TYPE = N'Размещение ZX 20-50' THEN 14.50
        WHEN r.WORK_TYPE = N'Размещение КС' THEN 15.40
        WHEN r.WORK_TYPE = N'Размещение NG' THEN 3.80
        WHEN r.WORK_TYPE = N'Размещение WH2' THEN 2.70
        WHEN r.WORK_TYPE = N'Размещение брака/боя' THEN 1.10
        WHEN r.WORK_TYPE = N'Размещение транзит' THEN 2.20
        WHEN r.WORK_TYPE = N'Размещение ZX КПП' THEN 3.60
        ELSE 0.00
    END AS price_per_op
FROM #placement_groups g
JOIN dwh.placement_cache r
    ON g.REFERENCE_ID = r.REFERENCE_ID
    AND g.ITEM = r.ITEM
    AND g.TO_LOC = r.TO_LOC
    AND g.max_end_time = r.END_DATE_TIME
GROUP BY
    r.WORK_TYPE,
    g.REFERENCE_ID,
    g.REFERENCE_TYPE,
    g.ITEM,
    g.TO_LOC,
    r.COMPLETED_BY_USER,
    g.max_end_time;

INSERT INTO dwh.fact_operation
SELECT
    CAST(p.start_time AS DATE),
    e.employee_id,
    wt.work_type_id,
    p.REFERENCE_ID,
    p.REFERENCE_TYPE,
    p.start_time,
    p.end_time,
    p.duration_sec,
    p.price_per_op,
    CASE WHEN p.REFERENCE_TYPE IN ('Клиент', 'Филиал', 'Ювелс') THEN 1 ELSE 0 END,
    'WMS'
FROM #placement_final p
JOIN dm.dim_employee e
    ON p.COMPLETED_BY_USER COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
    AND e.is_active = 1
JOIN dm.dim_work_type wt
    ON p.WORK_TYPE COLLATE Cyrillic_General_100_CI_AS = wt.work_type_name COLLATE Cyrillic_General_100_CI_AS;

-- fact_penalty
CREATE TABLE dwh.fact_penalty (
    date_key DATE NOT NULL,
    employee_id INT NOT NULL,
    reference_id NVARCHAR(50) NULL,
    fine_category NVARCHAR(200) NOT NULL,
    fine_amount DECIMAL(18,2) NOT NULL,
    event_time DATETIME2(0) NOT NULL
);

ALTER TABLE dwh.fact_penalty ADD CONSTRAINT FK_fact_penalty_date FOREIGN KEY (date_key) REFERENCES dm.dim_date(date_key);
ALTER TABLE dwh.fact_penalty ADD CONSTRAINT FK_fact_penalty_employee FOREIGN KEY (employee_id) REFERENCES dm.dim_employee(employee_id);

INSERT INTO dwh.fact_penalty
SELECT
    f.date,
    e.employee_id,
    f.reference_id,
    f.fine_category,
    f.fine_amount,
    f.date_time_stamp
FROM dwh.fines_enriched f
JOIN dm.dim_employee e
    ON f.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS;

-- fact_rejection
CREATE TABLE dwh.fact_rejection (
    date_key DATE NOT NULL,
    shipment_id NVARCHAR(25) NOT NULL,
    item NVARCHAR(25) NOT NULL,
    pick_zone NVARCHAR(25) NULL,
    event_time DATETIME2(0) NOT NULL
);

ALTER TABLE dwh.fact_rejection ADD CONSTRAINT FK_fact_rejection_date FOREIGN KEY (date_key) REFERENCES dm.dim_date(date_key);

INSERT INTO dwh.fact_rejection
SELECT
    CAST(DATE_TIME_STAMP AS DATE),
    SHIPMENT_ID,
    ITEM,
    PICK_ZONE,
    DATE_TIME_STAMP
FROM dwh.cube_shipment_detail;

-- fact_location_snapshot
CREATE TABLE dwh.fact_location_snapshot (
    date_key DATE NOT NULL,
    location_id NVARCHAR(25) NOT NULL,
    status NVARCHAR(50) NOT NULL,
    location_type NVARCHAR(25) NOT NULL,
    locating_zone NVARCHAR(25) NULL,
    allocation_zone NVARCHAR(25) NULL,
    work_zone NVARCHAR(25) NULL
);

ALTER TABLE dwh.fact_location_snapshot ADD CONSTRAINT FK_fact_location_date FOREIGN KEY (date_key) REFERENCES dm.dim_date(date_key);

WITH LatestLocation AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY LOCATION ORDER BY DATE_TIME_STAMP DESC) AS rn
    FROM raw_.LOCATION
    WHERE
        LOCATION_STS IS NOT NULL
        AND LOCATION_STS != 'Frozen'
        AND LOCATION_TYPE NOT IN ('Брак/бой DMG', 'Напольная', 'Улица KC', 'Ячейки KSP')
        AND (LOCATION_CLASS = 'Inventory' OR LOCATION_CLASS IS NULL)
),
OccupiedLocations AS (
    SELECT DISTINCT LOCATION
    FROM raw_.LOCATION_INVENTORY
    WHERE LOCATION IS NOT NULL
)
INSERT INTO dwh.fact_location_snapshot
SELECT
    CAST(GETDATE() AS DATE) AS date_key,
    l.LOCATION AS location_id,
    CASE
        WHEN o.LOCATION IS NOT NULL THEN 'Storage'
        ELSE 'Available'
    END AS status,
    l.LOCATION_TYPE AS location_type,
    l.LOCATING_ZONE AS locating_zone,
    l.ALLOCATION_ZONE AS allocation_zone,
    l.WORK_ZONE AS work_zone
FROM LatestLocation l
LEFT JOIN OccupiedLocations o ON l.LOCATION = o.LOCATION
WHERE l.rn = 1;

-- Удаляем временные таблицы
DROP TABLE IF EXISTS #pick_groups;
DROP TABLE IF EXISTS #pick_final;
DROP TABLE IF EXISTS #placement_groups;
DROP TABLE IF EXISTS #placement_final;

PRINT 'Скрипт 1 успешно завершён!';