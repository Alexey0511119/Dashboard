
CREATE PROCEDURE [raw_].[eks_sdelka_gruz]
    @data1 DATETIME,
    @data2 DATETIME
AS
BEGIN
    SET NOCOUNT ON;

    IF OBJECT_ID('tempdb..#r_header') > 0 DROP TABLE #r_header;
    IF OBJECT_ID('tempdb..#r_volume') > 0 DROP TABLE #r_volume;
    IF OBJECT_ID('tempdb..#r_meh') > 0 DROP TABLE #r_meh;
    IF OBJECT_ID('tempdb..#r_ruk') > 0 DROP TABLE #r_ruk;
    IF OBJECT_ID('tempdb..#r_sort') > 0 DROP TABLE #r_sort;
    IF OBJECT_ID('tempdb..#t1') > 0 DROP TABLE #t1;
    IF OBJECT_ID('tempdb..#t2') > 0 DROP TABLE #t2;
    IF OBJECT_ID('tempdb..#t3') > 0 DROP TABLE #t3;
    IF OBJECT_ID('tempdb..#t4') > 0 DROP TABLE #t4;
    IF OBJECT_ID('tempdb..#sort1') > 0 DROP TABLE #sort1;
    IF OBJECT_ID('tempdb..#s_header') > 0 DROP TABLE #s_header;
    IF OBJECT_ID('tempdb..#s_volume') > 0 DROP TABLE #s_volume;
    IF OBJECT_ID('tempdb..#s_meh') > 0 DROP TABLE #s_meh;
    IF OBJECT_ID('tempdb..#s_ruk') > 0 DROP TABLE #s_ruk;
    IF OBJECT_ID('tempdb..#s_sort') > 0 DROP TABLE #s_sort;
    IF OBJECT_ID('tempdb..#t5') > 0 DROP TABLE #t5;
    IF OBJECT_ID('tempdb..#sort2') > 0 DROP TABLE #sort2;

    DECLARE @T DATETIME = GETDATE();
    DECLARE @DDD DATETIME = DATEADD(MONTH, -6, @data1);

    -- Приходы
    SELECT interface_record_id, receipt_id COLLATE DATABASE_DEFAULT AS receipt_id, user_def5 COLLATE DATABASE_DEFAULT AS user_def5
    INTO #r_header
    FROM raw_.UPLOAD_RECEIPT_HEADER
    WHERE interface_condition = 'End'
      AND date_time_stamp BETWEEN @data1 AND @data2
    ORDER BY receipt_id;

    -- Объемы приходов
    WITH cte AS (
        SELECT receipt_id COLLATE DATABASE_DEFAULT AS receipt_id, total_qty * ium.length * ium.height * ium.width AS volume
        FROM raw_.UPLOAD_RECEIPT_DETAIL AS urd
        JOIN raw_.ITEM_UNIT_OF_MEASURE AS ium
            ON urd.item COLLATE DATABASE_DEFAULT = ium.item COLLATE DATABASE_DEFAULT
        WHERE interface_link_id IN (SELECT interface_record_id FROM #r_header)
          AND sequence = 1
        UNION ALL
        SELECT *
        FROM cte
        WHERE receipt_id IS NULL AND volume < 0
    )
    SELECT receipt_id, SUM(volume) / 1000000 AS volume
    INTO #r_volume
    FROM cte
    GROUP BY receipt_id
    ORDER BY receipt_id;

    PRINT 'Разгрузка: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Разгрузка механизмами
    SELECT tt.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / tt.kol FROM #r_volume AS v WHERE v.receipt_id COLLATE DATABASE_DEFAULT = tt.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #r_meh
    FROM (
        SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(t.kol) AS kol
        FROM (
            SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
              AND activity_type = N'Разгрузка механизмами'
            UNION ALL
            SELECT h.receipt_id COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            JOIN #r_header h ON h.user_def5 COLLATE DATABASE_DEFAULT = labor_management.user_def2 COLLATE DATABASE_DEFAULT
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND labor_management.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT user_def5 FROM #r_header)
              AND activity_type = N'Разгрузка механизмами'
        ) t
        GROUP BY t.user_def2
    ) tt;

    PRINT 'Разгрузка мех: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Разгрузка ручная
    SELECT tt.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / tt.kol FROM #r_volume AS v WHERE v.receipt_id COLLATE DATABASE_DEFAULT = tt.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #r_ruk
    FROM (
        SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(t.kol) AS kol
        FROM (
            SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
              AND activity_type = N'Разгрузка ручная'
            UNION ALL
            SELECT h.receipt_id COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            JOIN #r_header h ON h.user_def5 COLLATE DATABASE_DEFAULT = labor_management.user_def2 COLLATE DATABASE_DEFAULT
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND labor_management.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT user_def5 FROM #r_header)
              AND activity_type = N'Разгрузка ручная'
        ) t
        GROUP BY t.user_def2
    ) tt;

    PRINT 'Разгрузка руч: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Сортировка приемка
    SELECT tt.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / tt.kol FROM #r_volume AS v WHERE v.receipt_id COLLATE DATABASE_DEFAULT = tt.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #r_sort
    FROM (
        SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(t.kol) AS kol
        FROM (
            SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
              AND activity_type = N'Сортировка товаров'
            UNION ALL
            SELECT h.receipt_id COLLATE DATABASE_DEFAULT AS user_def2, UPPER(USER_NAME) COLLATE DATABASE_DEFAULT AS kol
            FROM raw_.labor_management
            JOIN #r_header h ON h.user_def5 COLLATE DATABASE_DEFAULT = labor_management.user_def2 COLLATE DATABASE_DEFAULT
            WHERE date_time_stamp > @DDD
              AND date_time_stamp <= @data2
              AND user_def1 = 'Receipt_doc'
              AND labor_management.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT user_def5 FROM #r_header)
              AND activity_type = N'Сортировка товаров'
        ) t
        GROUP BY t.user_def2
    ) tt;

    PRINT 'Сортировка приемка: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Расчет разгрузки механизмами по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#r_meh.volume) AS [Разгрузка_механизмами]
    INTO #t1
    FROM raw_.labor_management AS lab
    JOIN #r_meh ON lab.user_def2 COLLATE DATABASE_DEFAULT = #r_meh.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Receipt_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
      AND activity_type = N'Разгрузка механизмами'
    GROUP BY UPPER(lab.USER_NAME);

    -- Расчет разгрузки ручной по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#r_ruk.volume) AS [Разгрузка_ручная]
    INTO #t2
    FROM raw_.labor_management AS lab
    JOIN #r_ruk ON lab.user_def2 COLLATE DATABASE_DEFAULT = #r_ruk.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Receipt_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
      AND activity_type = N'Разгрузка ручная'
    GROUP BY UPPER(lab.USER_NAME);

    -- Сортировка приемка по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#r_sort.volume) AS sort
    INTO #sort1
    FROM raw_.labor_management AS lab
    JOIN #r_sort ON lab.user_def2 COLLATE DATABASE_DEFAULT = #r_sort.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Receipt_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT receipt_id FROM #r_header)
      AND activity_type = N'Сортировка товаров'
    GROUP BY UPPER(lab.USER_NAME);

    PRINT 'Расчет по пользователям: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Отгрузки
    SELECT interface_record_id, shipment_id COLLATE DATABASE_DEFAULT AS shipment_id
    INTO #s_header
    FROM raw_.UPLOAD_ORDER_HEADER
    WHERE interface_condition = 'End'
      AND date_time_stamp BETWEEN @data1 AND @data2
      AND leading_sts = '900'
      AND trailing_sts = '900'
    ORDER BY shipment_id;

    -- Объемы отгрузок
    WITH cte AS (
        SELECT shipment_id COLLATE DATABASE_DEFAULT AS shipment_id, total_qty * ium.length * ium.height * ium.width AS volume
        FROM raw_.UPLOAD_ORDER_DETAIL AS usd
        JOIN raw_.ITEM_UNIT_OF_MEASURE AS ium
            ON usd.item COLLATE DATABASE_DEFAULT = ium.item COLLATE DATABASE_DEFAULT
        WHERE interface_link_id IN (SELECT interface_record_id FROM #s_header)
          AND sequence = 1
        UNION ALL
        SELECT *
        FROM cte
        WHERE shipment_id IS NULL AND volume < 0
    )
    SELECT shipment_id, SUM(volume) / 1000000 AS volume
    INTO #s_volume
    FROM cte
    GROUP BY shipment_id
    ORDER BY shipment_id;

    PRINT 'Отгрузка: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Загрузка механизмами
    SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / t.kol FROM #s_volume AS v WHERE v.shipment_id COLLATE DATABASE_DEFAULT = t.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #s_meh
    FROM (
        SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(UPPER(USER_NAME)) AS kol
        FROM raw_.labor_management
        WHERE date_time_stamp > @DDD
          AND date_time_stamp <= @data2
          AND user_def1 = 'Shipping_doc'
          AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
          AND activity_type = N'Загрузка механизмами'
        GROUP BY user_def2
    ) t;

    -- Загрузка ручная
    SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / t.kol FROM #s_volume AS v WHERE v.shipment_id COLLATE DATABASE_DEFAULT = t.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #s_ruk
    FROM (
        SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(UPPER(USER_NAME)) AS kol
        FROM raw_.labor_management
        WHERE date_time_stamp > @DDD
          AND date_time_stamp <= @data2
          AND user_def1 = 'Shipping_doc'
          AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
          AND activity_type <> N'Загрузка механизмами'
        GROUP BY user_def2
    ) t;

    -- Сортировка отгрузка
    SELECT t.user_def2 COLLATE DATABASE_DEFAULT AS user_def2,
           (SELECT v.volume / t.kol FROM #s_volume AS v WHERE v.shipment_id COLLATE DATABASE_DEFAULT = t.user_def2 COLLATE DATABASE_DEFAULT) AS volume
    INTO #s_sort
    FROM (
        SELECT user_def2 COLLATE DATABASE_DEFAULT AS user_def2, COUNT(UPPER(USER_NAME)) AS kol
        FROM raw_.labor_management
        WHERE date_time_stamp > @DDD
          AND date_time_stamp <= @data2
          AND user_def1 = 'Shipping_doc'
          AND user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
          AND activity_type = N'Сортировка товаров'
        GROUP BY user_def2
    ) t;

    PRINT 'Загрузка: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Загрузка механизмами по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#s_meh.volume) AS [Загрузка механизмами]
    INTO #t3
    FROM raw_.labor_management AS lab
    JOIN #s_meh ON lab.user_def2 COLLATE DATABASE_DEFAULT = #s_meh.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Shipping_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
      AND activity_type = N'Загрузка механизмами'
    GROUP BY UPPER(lab.USER_NAME);

    -- Загрузка ручная по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#s_ruk.volume) AS [Загрузка ручная]
    INTO #t4
    FROM raw_.labor_management AS lab
    JOIN #s_ruk ON lab.user_def2 COLLATE DATABASE_DEFAULT = #s_ruk.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Shipping_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
      AND activity_type = N'Загрузка ручная'
    GROUP BY UPPER(lab.USER_NAME);

    -- Сортировка отгрузка по пользователям
    SELECT UPPER(lab.USER_NAME) COLLATE DATABASE_DEFAULT AS [user],
           SUM(#s_sort.volume) AS sort
    INTO #sort2
    FROM raw_.labor_management AS lab
    JOIN #s_sort ON lab.user_def2 COLLATE DATABASE_DEFAULT = #s_sort.user_def2 COLLATE DATABASE_DEFAULT
    WHERE date_time_stamp > @DDD
      AND date_time_stamp <= @data2
      AND user_def1 = 'Shipping_doc'
      AND lab.user_def2 COLLATE DATABASE_DEFAULT IN (SELECT shipment_id FROM #s_header)
      AND activity_type = N'Сортировка товаров'
    GROUP BY UPPER(lab.USER_NAME);

    PRINT 'Расчет загрузки: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Общая сортировка
    SELECT ttt.[user] COLLATE DATABASE_DEFAULT AS [user], (ttt.s1 + ttt.s2) AS [Сортировка товаров]
    INTO #t5
    FROM (
        SELECT tt.[user],
               ISNULL((SELECT sort FROM #sort1 WHERE [user] COLLATE DATABASE_DEFAULT = tt.[user] COLLATE DATABASE_DEFAULT), 0) AS s1,
               ISNULL((SELECT sort FROM #sort2 WHERE [user] COLLATE DATABASE_DEFAULT = tt.[user] COLLATE DATABASE_DEFAULT), 0) AS s2
        FROM (
            SELECT DISTINCT [user] COLLATE DATABASE_DEFAULT AS [user]
            FROM (
                SELECT [user] FROM #sort1
                UNION ALL
                SELECT [user] FROM #sort2
            ) AS t
        ) AS tt
    ) AS ttt;

    -- Финальный результат
    SELECT DISTINCT t.[user] COLLATE DATABASE_DEFAULT AS [user],
                    ISNULL((SELECT #t1.[Разгрузка_механизмами] FROM #t1 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Разгрузка_механизмами],
                    ISNULL((SELECT #t2.[Разгрузка_ручная] FROM #t2 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Разгрузка_ручная],
                    ISNULL((SELECT #t3.[Загрузка механизмами] FROM #t3 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Загрузка механизмами],
                    ISNULL((SELECT #t4.[Загрузка ручная] FROM #t4 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Загрузка ручная],
                    ISNULL((SELECT #sort1.sort FROM #sort1 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Сортировка товаров приемка],
                    ISNULL((SELECT #sort2.sort FROM #sort2 WHERE [user] COLLATE DATABASE_DEFAULT = t.[user] COLLATE DATABASE_DEFAULT), 0) AS [Сортировка товаров отгрузка]
    FROM (
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #t1
        UNION ALL
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #t2
        UNION ALL
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #t3
        UNION ALL
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #t4
        UNION ALL
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #sort1
        UNION ALL
        SELECT [user] COLLATE DATABASE_DEFAULT AS [user] FROM #sort2
    ) t
    ORDER BY t.[user];

    -- Очистка
    DROP TABLE #r_header;
    DROP TABLE #r_volume;
    DROP TABLE #r_meh;
    DROP TABLE #r_ruk;
    DROP TABLE #s_header;
    DROP TABLE #s_volume;
    DROP TABLE #s_meh;
    DROP TABLE #s_ruk;
    DROP TABLE #sort1;
    DROP TABLE #sort2;
    DROP TABLE #r_sort;
    DROP TABLE #s_sort;
    DROP TABLE #t1;
    DROP TABLE #t2;
    DROP TABLE #t3;
    DROP TABLE #t4;
    DROP TABLE #t5;

    PRINT 'Время выполнения: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
END








CREATE PROCEDURE [raw_].[eks_sdelka_priem]
    @data1 DATETIME,
    @data2 DATETIME
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @T DATETIME = GETDATE();

    IF OBJECT_ID('tempdb..#tempN2') > 0 DROP TABLE #tempN2;
    IF OBJECT_ID('tempdb..#temp3') > 0 DROP TABLE #temp3;
    IF OBJECT_ID('tempdb..#temp4') > 0 DROP TABLE #temp4;

    -- Находим последний контейнер для каждого receipt_id, item, to_location
    SELECT receipt_id COLLATE DATABASE_DEFAULT AS receipt_id,
           item COLLATE DATABASE_DEFAULT AS item,
           to_location COLLATE DATABASE_DEFAULT AS to_location,
           MAX(INTERNAL_REC_CONT_NUM) AS nomer
    INTO #tempN2
    FROM (
        SELECT T1.RECEIPT_ID, T2.INTERNAL_REC_CONT_NUM, T2.ITEM, T2.TO_LOCATION
        FROM raw_.UPLOAD_RECEIPT_HEADER T1
        INNER JOIN raw_.RECEIPT_container_view T2 ON T1.RECEIPT_ID = T2.RECEIPT_ID
        WHERE T1.date_time_stamp BETWEEN @data1 AND @data2
          AND (T1.interface_condition = 'End' OR T1.receipt_id_type = N'ТР')
    ) temp
    GROUP BY receipt_id, item, to_location;

    PRINT 'Шаг 1: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Получаем container_id для последних контейнеров
    SELECT #tempN2.*, rcv.container_id
    INTO #temp3
    FROM #tempN2
    JOIN raw_.receipt_container_view rcv ON rcv.INTERNAL_REC_CONT_NUM COLLATE DATABASE_DEFAULT = #tempN2.nomer COLLATE DATABASE_DEFAULT;

    PRINT 'Шаг 2: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Получаем историю транзакций для контейнеров
    SELECT t3.container_id,
           thv.DATE_TIME_STAMP,
           up.USER_NAME COLLATE DATABASE_DEFAULT AS user_name
    INTO #temp4
    FROM #temp3 t3
    INNER JOIN raw_.TRANSACTION_HISTORY_view thv ON t3.container_id = thv.CONTAINER_ID
    INNER JOIN raw_.USER_PROFILE up ON thv.USER_STAMP COLLATE DATABASE_DEFAULT = up.USER_NAME COLLATE DATABASE_DEFAULT
    WHERE thv.transaction_type = '20'
      AND thv.date_time_stamp > '11-01-2013 00:00:00';

    PRINT 'Шаг 3: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Выбираем последнюю операцию для каждого контейнера
    SELECT user_name, COUNT(container_id) AS kol
    FROM #temp4 tmp1
    WHERE date_time_stamp = (
        SELECT TOP 1 date_time_stamp
        FROM #temp4 tmp2
        WHERE tmp2.Container_id = tmp1.Container_id
        ORDER BY date_time_stamp DESC
    )
    GROUP BY user_name
    ORDER BY user_name;

    PRINT 'Шаг 4: ' + CAST(DATEDIFF(ms, @T, GETDATE()) AS NVARCHAR) + ' мс';
    SET @T = GETDATE();

    -- Очистка
    DROP TABLE #tempN2;
    DROP TABLE #temp3;
    DROP TABLE #temp4;
END




CREATE PROCEDURE raw_.USP_UPDATE_GROUP_LOAD
AS
BEGIN
    SET NOCOUNT ON;
    
    -- Очищаем таблицу
    TRUNCATE TABLE raw_.GROUP_LOAD_MONITOR;
    
    -- Заполняем данными из VIEW
    INSERT INTO raw_.GROUP_LOAD_MONITOR (
        group_id,
        group_name,
        work_type,
        open_tasks_count,
        employees_count,
        normativ_per_task,
        required_time,
        available_time,
        utilization_percent,
        status_color,
        last_updated
    )
    SELECT 
        group_id,
        group_name,
        work_type,
        open_tasks_count,
        employees_count,
        normativ_per_task,
        required_time,
        available_time,
        utilization_percent,
        status_color,
        GETDATE() AS last_updated
    FROM raw_.VW_GROUP_LOAD_MONITOR;
END;
