#!/usr/bin/env python3
import pymssql
import logging
import os
from datetime import datetime

# === Конфигурация ===
SRC_SERVER = '10.7.0.248'
SRC_PORT = 1433
SRC_DATABASE = 'ils'
SRC_USER = 'manhreader'
SRC_PASSWORD = 'August2021'

DST_SERVER = '10.7.0.27'
DST_DATABASE = 'olap2_fixed'
DST_USER = 'sa'
DST_PASSWORD = 'Rdflhfn600'

log_dir = "/home/admin1/script/logs"
os.makedirs(log_dir, exist_ok=True)
logging.basicConfig(
    filename=os.path.join(log_dir, "dimensions.log"),
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

DIMENSIONS = ['LOCATION', 'LOCATION_TYPE', 'ITEM']

def get_src_conn():
    return pymssql.connect(
        server=SRC_SERVER,
        port=SRC_PORT,
        user=SRC_USER,
        password=SRC_PASSWORD,
        database=SRC_DATABASE,
        tds_version='7.0'
    )

def get_dst_conn():
    return pymssql.connect(
        server=DST_SERVER,
        user=DST_USER,
        password=DST_PASSWORD,
        database=DST_DATABASE
    )

def load_table(table_name):
    print(f"🔄 Загрузка справочника: {table_name}")
    src = get_src_conn()
    dst = get_dst_conn()
    try:
        src_cursor = src.cursor()
        dst_cursor = dst.cursor()

        dst_cursor.execute(f"TRUNCATE TABLE raw_.{table_name}")
        dst.commit()

        src_cursor.execute(f"SELECT * FROM {table_name}")
        rows = src_cursor.fetchall()
        if rows:
            placeholders = ",".join(["%s"] * len(rows[0]))
            insert_sql = f"INSERT INTO raw_.{table_name} VALUES ({placeholders})"
            dst_cursor.executemany(insert_sql, rows)
            dst.commit()
        print(f"✅ {table_name}: загружено {len(rows)} строк")
        logging.info(f"Загружено {len(rows)} строк в {table_name}")
    finally:
        src.close()
        dst.close()

def main():
    print("=== ЗАГРУЗКА СПРАВОЧНИКОВ ===")
    for tbl in DIMENSIONS:
        load_table(tbl)
    print("🏁 Все справочники обновлены")

if __name__ == "__main__":
    main()