-- ============================================================================
-- СКРИПТ 3: РАСЧЁТ ГРУЗЧИКОВ (gruz_operations)
-- Выполняется ПЕРЕД Скриптом 1 и 2
-- ============================================================================
USE olap2_fixed;
GO

-- ====== ШАГ 0: Очистка ======
IF OBJECT_ID('raw_.gruz_operations') IS NOT NULL DROP TABLE raw_.gruz_operations;
IF OBJECT_ID('dwh.transaction_events') IS NOT NULL DROP TABLE dwh.transaction_events;

-- ====== ШАГ 1: Создание таблицы gruz_operations ======
CREATE TABLE raw_.gruz_operations (
    user_name NVARCHAR(100) COLLATE Cyrillic_General_100_CI_AS NOT NULL,
    date_key DATE NOT NULL,
    [Разгрузка механизмами] DECIMAL(18,2) NOT NULL DEFAULT 0,
    [Разгрузка ручная] DECIMAL(18,2) NOT NULL DEFAULT 0,
    [Загрузка механизмами] DECIMAL(18,2) NOT NULL DEFAULT 0,
    [Загрузка ручная] DECIMAL(18,2) NOT NULL DEFAULT 0,
    [Сортировка товаров приемка] DECIMAL(18,2) NOT NULL DEFAULT 0,
    [Сортировка товаров отгрузка] DECIMAL(18,2) NOT NULL DEFAULT 0
);

-- ====== ШАГ 2: Создание transaction_events (приёмка) ======
SELECT
    TRY_CAST(t.DATE_TIME_STAMP AS DATE) AS date_key,
    t.USER_NAME AS user_name,
    u.fio,
    u.smena,
    u.brigada,
    u.position,
    TRY_CAST(t.DATE_TIME_STAMP AS DATETIME2(0)) AS event_time
INTO dwh.transaction_events
FROM raw_.TRANSACTION_HISTORY t
JOIN raw_.USER_CADR_EDIT u
    ON t.USER_NAME COLLATE Cyrillic_General_100_CI_AS = u.user_name COLLATE Cyrillic_General_100_CI_AS
    AND u.deleted = 0
WHERE
    t.TRANSACTION_TYPE = '20'
    AND t.DATE_TIME_STAMP IS NOT NULL
    AND u.smena IN ('1', '2');

PRINT 'Начинаю расчёт грузчиков с группировкой по дням...';

-- ====== ШАГ 3: Очистка временных таблиц ======
IF OBJECT_ID('tempdb..#r_header') IS NOT NULL DROP TABLE #r_header;
IF OBJECT_ID('tempdb..#r_volume_by_date') IS NOT NULL DROP TABLE #r_volume_by_date;
IF OBJECT_ID('tempdb..#s_header') IS NOT NULL DROP TABLE #s_header;
IF OBJECT_ID('tempdb..#s_volume_by_date') IS NOT NULL DROP TABLE #s_volume_by_date;
IF OBJECT_ID('tempdb..#unload_mech') IS NOT NULL DROP TABLE #unload_mech;
IF OBJECT_ID('tempdb..#unload_manual') IS NOT NULL DROP TABLE #unload_manual;
IF OBJECT_ID('tempdb..#load_mech') IS NOT NULL DROP TABLE #load_mech;
IF OBJECT_ID('tempdb..#load_manual') IS NOT NULL DROP TABLE #load_manual;
IF OBJECT_ID('tempdb..#sort_receipt') IS NOT NULL DROP TABLE #sort_receipt;
IF OBJECT_ID('tempdb..#sort_shipment') IS NOT NULL DROP TABLE #sort_shipment;

DECLARE @start_date DATE = '2024-01-01';
DECLARE @end_date DATE = '2026-02-12';

-- ============================================================================
-- ПРИХОДЫ (Разгрузка)
-- ============================================================================
SELECT
    interface_record_id,
    receipt_id,
    user_def5,
    CAST(date_time_stamp AS DATE) AS receipt_date
INTO #r_header
FROM raw_.UPLOAD_RECEIPT_HEADER
WHERE interface_condition = 'End'
    AND CAST(date_time_stamp AS DATE) BETWEEN @start_date AND @end_date;

SELECT
    urd.interface_link_id,
    rh.receipt_date,
    SUM(urd.total_qty * ium.length * ium.height * ium.width) / 1000000.0 AS volume
INTO #r_volume_by_date
FROM raw_.UPLOAD_RECEIPT_DETAIL urd
JOIN raw_.ITEM_UNIT_OF_MEASURE ium
    ON urd.item COLLATE Cyrillic_General_100_CI_AS = ium.item COLLATE Cyrillic_General_100_CI_AS
    AND urd.QUANTITY_UM COLLATE Cyrillic_General_100_CI_AS = ium.QUANTITY_UM COLLATE Cyrillic_General_100_CI_AS
JOIN #r_header rh
    ON urd.interface_link_id = rh.interface_record_id
GROUP BY urd.interface_link_id, rh.receipt_date;

-- ============================================================================
-- ОТГРУЗКИ (Загрузка)
-- ============================================================================
SELECT
    interface_record_id,
    shipment_id,
    CAST(date_time_stamp AS DATE) AS shipment_date
INTO #s_header
FROM raw_.UPLOAD_ORDER_HEADER
WHERE interface_condition = 'End'
    AND CAST(date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
    AND leading_sts = '900'
    AND trailing_sts = '900';

SELECT
    usd.interface_link_id,
    sh.shipment_date,
    SUM(usd.total_qty * ium.length * ium.height * ium.width) / 1000000.0 AS volume
INTO #s_volume_by_date
FROM raw_.UPLOAD_ORDER_DETAIL usd
JOIN raw_.ITEM_UNIT_OF_MEASURE ium
    ON usd.item COLLATE Cyrillic_General_100_CI_AS = ium.item COLLATE Cyrillic_General_100_CI_AS
    AND usd.QUANTITY_UM COLLATE Cyrillic_General_100_CI_AS = ium.QUANTITY_UM COLLATE Cyrillic_General_100_CI_AS
JOIN #s_header sh
    ON usd.interface_link_id = sh.interface_record_id
GROUP BY usd.interface_link_id, sh.shipment_date;

-- ============================================================================
-- РАСЧЁТ ОПЕРАЦИЙ ПО ДАТАМ
-- ============================================================================
-- Разгрузка механизмами ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(rv.volume) AS volume
INTO #unload_mech
FROM raw_.labor_management lmd
JOIN #r_header rh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS IN (rh.receipt_id COLLATE Cyrillic_General_100_CI_AS, rh.user_def5 COLLATE Cyrillic_General_100_CI_AS)
JOIN #r_volume_by_date rv
    ON rv.interface_link_id = rh.interface_record_id
    AND rv.receipt_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Receipt_doc'
    AND lmd.activity_type = N'Разгрузка механизмами'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- Разгрузка ручная ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(rv.volume) AS volume
INTO #unload_manual
FROM raw_.labor_management lmd
JOIN #r_header rh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS IN (rh.receipt_id COLLATE Cyrillic_General_100_CI_AS, rh.user_def5 COLLATE Cyrillic_General_100_CI_AS)
JOIN #r_volume_by_date rv
    ON rv.interface_link_id = rh.interface_record_id
    AND rv.receipt_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Receipt_doc'
    AND lmd.activity_type = N'Разгрузка ручная'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- Загрузка механизмами ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(sv.volume) AS volume
INTO #load_mech
FROM raw_.labor_management lmd
JOIN #s_header sh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS = sh.shipment_id COLLATE Cyrillic_General_100_CI_AS
JOIN #s_volume_by_date sv
    ON sv.interface_link_id = sh.interface_record_id
    AND sv.shipment_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Shipping_doc'
    AND lmd.activity_type = N'Загрузка механизмами'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- Загрузка ручная ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(sv.volume) AS volume
INTO #load_manual
FROM raw_.labor_management lmd
JOIN #s_header sh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS = sh.shipment_id COLLATE Cyrillic_General_100_CI_AS
JOIN #s_volume_by_date sv
    ON sv.interface_link_id = sh.interface_record_id
    AND sv.shipment_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Shipping_doc'
    AND lmd.activity_type <> N'Загрузка механизмами'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- Сортировка приемка ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(rv.volume) AS volume
INTO #sort_receipt
FROM raw_.labor_management lmd
JOIN #r_header rh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS IN (rh.receipt_id COLLATE Cyrillic_General_100_CI_AS, rh.user_def5 COLLATE Cyrillic_General_100_CI_AS)
JOIN #r_volume_by_date rv
    ON rv.interface_link_id = rh.interface_record_id
    AND rv.receipt_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Receipt_doc'
    AND lmd.activity_type = N'Сортировка товаров'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- Сортировка отгрузка ПО ДАТАМ
SELECT
    UPPER(lmd.user_name) AS user_name,
    CAST(lmd.date_time_stamp AS DATE) AS date_key,
    SUM(sv.volume) AS volume
INTO #sort_shipment
FROM raw_.labor_management lmd
JOIN #s_header sh
    ON lmd.user_def2 COLLATE Cyrillic_General_100_CI_AS = sh.shipment_id COLLATE Cyrillic_General_100_CI_AS
JOIN #s_volume_by_date sv
    ON sv.interface_link_id = sh.interface_record_id
    AND sv.shipment_date = CAST(lmd.date_time_stamp AS DATE)
WHERE lmd.user_def1 = 'Shipping_doc'
    AND lmd.activity_type = N'Сортировка товаров'
    AND CAST(lmd.date_time_stamp AS DATE) BETWEEN @start_date AND @end_date
GROUP BY UPPER(lmd.user_name), CAST(lmd.date_time_stamp AS DATE);

-- ============================================================================
-- ФИНАЛЬНАЯ ВСТАВКА
-- ============================================================================
INSERT INTO raw_.gruz_operations (
    user_name,
    date_key,
    [Разгрузка механизмами],
    [Разгрузка ручная],
    [Загрузка механизмами],
    [Загрузка ручная],
    [Сортировка товаров приемка],
    [Сортировка товаров отгрузка]
)
SELECT
    COALESCE(um.user_name, ur.user_name, lm.user_name, lr.user_name, sr.user_name, ss.user_name) AS user_name,
    COALESCE(um.date_key, ur.date_key, lm.date_key, lr.date_key, sr.date_key, ss.date_key) AS date_key,
    ISNULL(um.volume, 0) AS [Разгрузка механизмами],
    ISNULL(ur.volume, 0) AS [Разгрузка ручная],
    ISNULL(lm.volume, 0) AS [Загрузка механизмами],
    ISNULL(lr.volume, 0) AS [Загрузка ручная],
    ISNULL(sr.volume, 0) AS [Сортировка товаров приемка],
    ISNULL(ss.volume, 0) AS [Сортировка товаров отгрузка]
FROM (
    SELECT user_name, date_key FROM #unload_mech
    UNION
    SELECT user_name, date_key FROM #unload_manual
    UNION
    SELECT user_name, date_key FROM #load_mech
    UNION
    SELECT user_name, date_key FROM #load_manual
    UNION
    SELECT user_name, date_key FROM #sort_receipt
    UNION
    SELECT user_name, date_key FROM #sort_shipment
) t
LEFT JOIN #unload_mech um ON t.user_name = um.user_name AND t.date_key = um.date_key
LEFT JOIN #unload_manual ur ON t.user_name = ur.user_name AND t.date_key = ur.date_key
LEFT JOIN #load_mech lm ON t.user_name = lm.user_name AND t.date_key = lm.date_key
LEFT JOIN #load_manual lr ON t.user_name = lr.user_name AND t.date_key = lr.date_key
LEFT JOIN #sort_receipt sr ON t.user_name = sr.user_name AND t.date_key = sr.date_key
LEFT JOIN #sort_shipment ss ON t.user_name = ss.user_name AND t.date_key = ss.date_key;

PRINT 'Расчёт грузчиков завершён (с группировкой по дням).';