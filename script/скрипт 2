-- ============================================================================
-- СКРИПТ 2: ВСТАВКА ГРУЗЧИКОВ В fact_operation
-- Выполняется ПОСЛЕ Скрипта 1
-- ============================================================================
USE olap2_fixed;
GO

-- Удаляем старые записи грузчиков (на случай повторного запуска)
DELETE FROM dwh.fact_operation WHERE source_system = 'GRUZ';

-- ============================================================================
-- РАЗГРУЗКА МЕХАНИЗМАМИ
-- ============================================================================
INSERT INTO dwh.fact_operation (
    date_key, employee_id, work_type_id, reference_id, reference_type,
    start_time, end_time, duration_sec, price_per_op, is_order, source_system
)
SELECT
    g.date_key,
    e.employee_id,
    wt.work_type_id,
    NULL AS reference_id,
    'Разгрузка механизмами' AS reference_type,
    MIN(lm.date_time_stamp) AS start_time,
    MAX(lm.date_time_stamp) AS end_time,
    DATEDIFF(SECOND, MIN(lm.date_time_stamp), MAX(lm.date_time_stamp)) AS duration_sec,
    g.[Разгрузка механизмами] * 22.50 AS price_per_op,
    0 AS is_order,
    'GRUZ' AS source_system
FROM raw_.gruz_operations g
JOIN dm.dim_employee e
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
JOIN dm.dim_work_type wt
    ON wt.work_type_name = N'Разгрузка механизмами'
JOIN raw_.labor_management lm
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = lm.user_name COLLATE Cyrillic_General_100_CI_AS
    AND g.date_key = CAST(lm.date_time_stamp AS DATE)
    AND lm.activity_type = N'Разгрузка механизмами'
WHERE g.[Разгрузка механизмами] > 0
GROUP BY g.date_key, e.employee_id, wt.work_type_id, g.[Разгрузка механизмами];

-- ============================================================================
-- РАЗГРУЗКА РУЧНАЯ
-- ============================================================================
INSERT INTO dwh.fact_operation (
    date_key, employee_id, work_type_id, reference_id, reference_type,
    start_time, end_time, duration_sec, price_per_op, is_order, source_system
)
SELECT
    g.date_key,
    e.employee_id,
    wt.work_type_id,
    NULL AS reference_id,
    'Разгрузка ручная' AS reference_type,
    MIN(lm.date_time_stamp) AS start_time,
    MAX(lm.date_time_stamp) AS end_time,
    DATEDIFF(SECOND, MIN(lm.date_time_stamp), MAX(lm.date_time_stamp)) AS duration_sec,
    g.[Разгрузка ручная] * 22.50 AS price_per_op,
    0 AS is_order,
    'GRUZ' AS source_system
FROM raw_.gruz_operations g
JOIN dm.dim_employee e
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
JOIN dm.dim_work_type wt
    ON wt.work_type_name = N'Разгрузка ручная'
JOIN raw_.labor_management lm
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = lm.user_name COLLATE Cyrillic_General_100_CI_AS
    AND g.date_key = CAST(lm.date_time_stamp AS DATE)
    AND lm.activity_type = N'Разгрузка ручная'
WHERE g.[Разгрузка ручная] > 0
GROUP BY g.date_key, e.employee_id, wt.work_type_id, g.[Разгрузка ручная];

-- ============================================================================
-- ЗАГРУЗКА МЕХАНИЗМАМИ
-- ============================================================================
INSERT INTO dwh.fact_operation (
    date_key, employee_id, work_type_id, reference_id, reference_type,
    start_time, end_time, duration_sec, price_per_op, is_order, source_system
)
SELECT
    g.date_key,
    e.employee_id,
    wt.work_type_id,
    NULL AS reference_id,
    'Загрузка механизмами' AS reference_type,
    MIN(lm.date_time_stamp) AS start_time,
    MAX(lm.date_time_stamp) AS end_time,
    DATEDIFF(SECOND, MIN(lm.date_time_stamp), MAX(lm.date_time_stamp)) AS duration_sec,
    g.[Загрузка механизмами] * 68.40 AS price_per_op,
    0 AS is_order,
    'GRUZ' AS source_system
FROM raw_.gruz_operations g
JOIN dm.dim_employee e
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
JOIN dm.dim_work_type wt
    ON wt.work_type_name = N'Загрузка механизмами'
JOIN raw_.labor_management lm
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = lm.user_name COLLATE Cyrillic_General_100_CI_AS
    AND g.date_key = CAST(lm.date_time_stamp AS DATE)
    AND lm.activity_type = N'Загрузка механизмами'
WHERE g.[Загрузка механизмами] > 0
GROUP BY g.date_key, e.employee_id, wt.work_type_id, g.[Загрузка механизмами];

-- ============================================================================
-- ЗАГРУЗКА РУЧНАЯ
-- ============================================================================
INSERT INTO dwh.fact_operation (
    date_key, employee_id, work_type_id, reference_id, reference_type,
    start_time, end_time, duration_sec, price_per_op, is_order, source_system
)
SELECT
    g.date_key,
    e.employee_id,
    wt.work_type_id,
    NULL AS reference_id,
    'Загрузка ручная' AS reference_type,
    MIN(lm.date_time_stamp) AS start_time,
    MAX(lm.date_time_stamp) AS end_time,
    DATEDIFF(SECOND, MIN(lm.date_time_stamp), MAX(lm.date_time_stamp)) AS duration_sec,
    g.[Загрузка ручная] * 68.40 AS price_per_op,
    0 AS is_order,
    'GRUZ' AS source_system
FROM raw_.gruz_operations g
JOIN dm.dim_employee e
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = e.user_name COLLATE Cyrillic_General_100_CI_AS
JOIN dm.dim_work_type wt
    ON wt.work_type_name = N'Загрузка ручная'
JOIN raw_.labor_management lm
    ON g.user_name COLLATE Cyrillic_General_100_CI_AS = lm.user_name COLLATE Cyrillic_General_100_CI_AS
    AND g.date_key = CAST(lm.date_time_stamp AS DATE)
    AND lm.activity_type = N'Загрузка ручная'
WHERE g.[Загрузка ручная] > 0
GROUP BY g.date_key, e.employee_id, wt.work_type_id, g.[Загрузка ручная];

PRINT 'Вставка грузчиков в fact_operation завершена.';