    // agg_daily_sales - продажи по дням
let
    Shipments = fact_shipments_weekly,
    
    Grouped = Table.Group(Shipments, {"shipment_date"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"total_revenue", each List.Sum([revenue]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type},
        {"unique_managers", each List.Count(List.Distinct([sales_manager])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"shipment_date", Order.Ascending}}),
    AddedAvgPrice = Table.AddColumn(Sorted, "avg_price", each [total_revenue] / [total_quantity])
in
    AddedAvgPrice


    // agg_daily_receipts - приходы по дням
let
    Receipts = fact_receipts_weekly,
    
    Grouped = Table.Group(Receipts, {"receipt_date"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type},
        {"unique_managers", each List.Count(List.Distinct([manager])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"receipt_date", Order.Ascending}})
in
    Sorted


    // agg_stock_by_zone - остатки по зонам
let
    Stock = fact_stock_current,
    
    Grouped = Table.Group(Stock, {"zone_name"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"total_volume_m3", each List.Sum([total_volume_m3]), type number},
        {"total_weight_kg", each List.Sum([total_weight_kg]), type number},
        {"total_value", each List.Sum([total_value]), type number},
        {"occupied_bins", each List.Count(List.Distinct([location_code])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"zone_name", Order.Ascending}})
in
    Sorted


    // agg_stock_by_manager - остатки по менеджерам
let
    Stock = fact_stock_current,
    Items = dim_items_weekly,
    
    Merged = Table.NestedJoin(Stock, {"item_id"}, Items, {"item_id"}, "ItemInfo", JoinKind.LeftOuter),
    Expanded = Table.ExpandTableColumn(Merged, "ItemInfo", {"manager"}, {"item_manager"}),
    
    Grouped = Table.Group(Expanded, {"item_manager"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"total_value", each List.Sum([total_value]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"total_value", Order.Descending}})
in
    Sorted


    // agg_sales_by_manager - продажи по менеджерам
let
    Shipments = fact_shipments_weekly,
    
    Grouped = Table.Group(Shipments, {"sales_manager"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"total_revenue", each List.Sum([revenue]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type},
        {"avg_price", each List.Average([revenue] / [quantity]), type number}
    }),
    
    Sorted = Table.Sort(Grouped, {{"total_revenue", Order.Descending}})
in
    Sorted


    // agg_receipts_by_manager - приходы по менеджерам
let
    Receipts = fact_receipts_weekly,
    
    Grouped = Table.Group(Receipts, {"manager"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"total_quantity", Order.Descending}})
in
    Sorted


    // agg_movements_by_zone - перемещения по зонам
let
    Movements = fact_movements_weekly,
    
    Grouped = Table.Group(Movements, {"to_location"}, {
        {"total_quantity", each List.Sum([quantity]), type number},
        {"total_weight", each List.Sum([weight_kg]), type number},
        {"unique_items", each List.Count(List.Distinct([item_id])), Int64.Type}
    }),
    
    Sorted = Table.Sort(Grouped, {{"total_quantity", Order.Descending}})
