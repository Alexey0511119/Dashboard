    Sorted


    // agg_stock_turnover - оборачиваемость товаров
let
    Shipments = fact_shipments_weekly,
    SalesByItem = Table.Group(Shipments, {"item_id"}, {
        {"weekly_sales", each List.Sum([quantity]), type number}
    }),
    
    Stock = fact_stock_current,
    StockByItem = Table.Group(Stock, {"item_id"}, {
        {"current_stock", each List.Sum([quantity]), type number}
    }),
    
    Merged = Table.NestedJoin(SalesByItem, {"item_id"}, StockByItem, {"item_id"}, "Stock", JoinKind.LeftOuter),
    Expanded = Table.ExpandTableColumn(Merged, "Stock", {"current_stock"}, {"current_stock"}),
    
    ReplacedNulls = Table.ReplaceValue(Expanded, null, 0, Replacer.ReplaceValue, {"current_stock"}),
    
    AddedTurnover = Table.AddColumn(ReplacedNulls, "days_in_stock", 
        each if [weekly_sales] > 0 then ([current_stock] / [weekly_sales]) * 7 else 999)
in
    AddedTurnover


    // master_table - единый куб для анализа
let
    Stock = fact_stock_current,
    
    Items = dim_items_weekly,
    StockWithManager = Table.NestedJoin(Stock, {"item_id"}, Items, {"item_id"}, "Items", JoinKind.LeftOuter),
    ExpandedManager = Table.ExpandTableColumn(StockWithManager, "Items", {"manager", "cost_price", "sell_price"}, {"manager", "cost_price", "sell_price"}),
    
    Locations = dim_locations,
    StockWithLocation = Table.NestedJoin(ExpandedManager, {"location_code"}, Locations, {"location_code"}, "Locs", JoinKind.LeftOuter),
    ExpandedLocation = Table.ExpandTableColumn(StockWithLocation, "Locs", {"zone", "location_type", "bin_volume_m3"}, {"zone", "location_type", "bin_volume_m3"}),
    
    Shipments = fact_shipments_weekly,
    SalesByItem = Table.Group(Shipments, {"item_id"}, {
        {"total_sold_week", each List.Sum([quantity])},
        {"total_revenue_week", each List.Sum([revenue])}
    }),
    
    WithSales = Table.NestedJoin(ExpandedLocation, {"item_id"}, SalesByItem, {"item_id"}, "Sales", JoinKind.LeftOuter),
    ExpandedSales = Table.ExpandTableColumn(WithSales, "Sales", {"total_sold_week", "total_revenue_week"}, {"total_sold_week", "total_revenue_week"}),
    
    Receipts = fact_receipts_weekly,
    ReceiptsByItem = Table.Group(Receipts, {"item_id"}, {
        {"total_received_week", each List.Sum([quantity])}
    }),
    
    WithReceipts = Table.NestedJoin(ExpandedSales, {"item_id"}, ReceiptsByItem, {"item_id"}, "Receipts", JoinKind.LeftOuter),
    Final = Table.ExpandTableColumn(WithReceipts, "Receipts", {"total_received_week"}, {"total_received_week"}),
    
    ReplaceNulls = Table.ReplaceValue(Final, null, 0, Replacer.ReplaceValue, {"total_sold_week", "total_revenue_week", "total_received_week"}),
    
    AddedFields = Table.AddColumn(ReplaceNulls, "fill_percentage", each [total_volume_m3] / [bin_volume_m3] * 100),
    AddedFields2 = Table.AddColumn(AddedFields, "days_in_stock", 
        each if [total_sold_week] > 0 then ([quantity] / [total_sold_week]) * 7 else 999)
in
    AddedFields2