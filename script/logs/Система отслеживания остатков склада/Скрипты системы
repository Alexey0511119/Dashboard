// dim_items_weekly - товары за неделю
let
    Source = Sql.Databases("manh"),
    ILS = Source{[Name="ILS"]}[Data],
    SK = Source{[Name="SK"]}[Data],
    
    UPLOAD_ORDER_DETAIL = ILS{[Schema="dbo",Item="UPLOAD_ORDER_DETAIL"]}[Data],
    FilteredReceipts = Table.SelectRows(UPLOAD_ORDER_DETAIL, 
        each [DATE_TIME_STAMP] >= #datetime(2025, 12, 18, 0, 0, 0) and 
             [DATE_TIME_STAMP] <= #datetime(2025, 12, 25, 23, 59, 59)),
    UniqueItems = Table.Distinct(Table.SelectColumns(FilteredReceipts, {"ITEM"})),
    
    SHIPMENT_DETAIL = ILS{[Schema="dbo",Item="SHIPMENT_DETAIL"]}[Data],
    FilteredShipments = Table.SelectRows(SHIPMENT_DETAIL, 
        each [DATE_TIME_STAMP] >= #datetime(2025, 12, 18, 0, 0, 0) and 
             [DATE_TIME_STAMP] <= #datetime(2025, 12, 25, 23, 59, 59)),
    UniqueItems2 = Table.Distinct(Table.SelectColumns(FilteredShipments, {"ITEM"})),
    
    AllUniqueItems = Table.Combine({UniqueItems, UniqueItems2}),
    DistinctItems = Table.Distinct(AllUniqueItems, {"ITEM"}),
    
    ITEM = ILS{[Schema="dbo",Item="ITEM"]}[Data],
    FilteredItems = Table.NestedJoin(ITEM, {"ITEM"}, DistinctItems, {"ITEM"}, "Filtered", JoinKind.Inner),
    ItemsExpanded = Table.ExpandTableColumn(FilteredItems, "Filtered", {}, {}),
    
    View_7 = SK{[Schema="dbo",Item="View_7"]}[Data],
    Merged = Table.NestedJoin(ItemsExpanded, {"ITEM"}, View_7, {"ITEM"}, "View7", JoinKind.LeftOuter),
    Expanded = Table.ExpandTableColumn(Merged, "View7", {"Входная цена", "Розничная цена"}, {"Входная цена", "Розничная цена"}),
    
    Selected = Table.SelectColumns(Expanded, {"ITEM", "DESCRIPTION", "USER_DEF2", "Входная цена", "Розничная цена"}),
    Renamed = Table.RenameColumns(Selected, {
        {"ITEM", "item_id"},
        {"DESCRIPTION", "item_name"},
        {"USER_DEF2", "manager"},
        {"Входная цена", "cost_price"},
        {"Розничная цена", "sell_price"}
    }),
    
    Cleaned = Table.TransformColumns(Renamed, {
        {"cost_price", each if _ is text then Number.FromText(Text.Replace(_, ",", ".")) else _, type number},
        {"sell_price", each if _ is text then Number.FromText(Text.Replace(_, ",", ".")) else _, type number}
    })
in
    Cleaned



    // dim_locations - справочник мест хранения
let
    Source = Sql.Databases("manh"),
    ILS = Source{[Name="ILS"]}[Data],
    LOCATION = ILS{[Schema="dbo",Item="LOCATION"]}[Data],
    LOCATION_TYPE = ILS{[Schema="dbo",Item="LOCATION_TYPE"]}[Data],
    
    Merged = Table.NestedJoin(LOCATION, {"LOCATION_TYPE"}, LOCATION_TYPE, {"LOCATION_TYPE"}, "LOC_TYPE", JoinKind.LeftOuter),
    Expanded = Table.ExpandTableColumn(Merged, "LOC_TYPE", {"LENGTH", "WIDTH", "HEIGHT", "MAXIMUM_WEIGHT"}),
    
    AddedVolume = Table.AddColumn(Expanded, "bin_volume_m3", 
        each if [LENGTH] <> null then ([LENGTH] * [WIDTH] * [HEIGHT]) / 1000000 else null),
    
    Selected = Table.SelectColumns(AddedVolume, {
        "LOCATION", "LOCATING_ZONE", "LOCATION_TEMPLATE", 
        "LOCATION_TYPE", "bin_volume_m3", "MAXIMUM_WEIGHT"
    }),
    
    Renamed = Table.RenameColumns(Selected, {
        {"LOCATION", "location_code"},
        {"LOCATING_ZONE", "zone"},
        {"LOCATION_TEMPLATE", "zone_name"},
        {"LOCATION_TYPE", "location_type"},
        {"MAXIMUM_WEIGHT", "max_weight_kg"}
    })
in
    Renamed


    // dim_dates_weekly - календарь за неделю
let
    StartDate = #date(2025, 12, 18),
    EndDate = #date(2025, 12, 25),
    Days = Duration.Days(EndDate - StartDate) + 1,
    
    DatesList = List.Dates(StartDate, Days, #duration(1, 0, 0, 0)),
    Source = Table.FromList(DatesList, Splitter.SplitByNothing(), {"date"}),
    
    AddedYear = Table.AddColumn(Source, "year", each Date.Year([date])),
    AddedMonth = Table.AddColumn(AddedYear, "month", each Date.Month([date])),
    AddedMonthName = Table.AddColumn(AddedMonth, "month_name", each Date.ToText([date], "MMMM", "ru-RU")),
    AddedDay = Table.AddColumn(AddedMonthName, "day", each Date.Day([date])),
    AddedDayOfWeek = Table.AddColumn(AddedDay, "day_of_week", each Date.DayOfWeek([date], Day.Monday) + 1),
    AddedDayName = Table.AddColumn(AddedDayOfWeek, "day_name", each Date.ToText([date], "dddd", "ru-RU")),
    AddedIsWeekend = Table.AddColumn(AddedDayName, "is_weekend", each if [day_of_week] >= 6 then "Да" else "Нет")
in
    AddedIsWeekend


