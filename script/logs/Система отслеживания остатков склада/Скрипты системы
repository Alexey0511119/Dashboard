    // fact_stock_current - текущие остатки
let
    Source = Sql.Databases("manh"),
    ILS = Source{[Name="ILS"]}[Data],
    LOCATION_INVENTORY = ILS{[Schema="dbo",Item="LOCATION_INVENTORY"]}[Data],
    
    First5000 = Table.FirstN(LOCATION_INVENTORY, 5000),
    Filtered = Table.SelectRows(First5000, each [ON_HAND_QTY] > 0),
    
    Selected = Table.SelectColumns(Filtered, {
        "LOCATION_TEMPLATE", "ITEM", "ITEM_DESC", "ON_HAND_QTY", 
        "TOTAL_VOLUME", "TOTAL_WEIGHT", "TOTAL_VALUE", "LOCATION"
    }),
    
    Renamed = Table.RenameColumns(Selected, {
        {"LOCATION_TEMPLATE", "zone_name"},
        {"ITEM", "item_id"},
        {"ITEM_DESC", "item_name"},
        {"ON_HAND_QTY", "quantity"},
        {"TOTAL_VOLUME", "total_volume_cm3"},
        {"TOTAL_WEIGHT", "total_weight_kg"},
        {"TOTAL_VALUE", "total_value"},
        {"LOCATION", "location_code"}
    }),
    
    AddedVolume = Table.AddColumn(Renamed, "total_volume_m3", each [total_volume_cm3] / 1000000)
in
    AddedVolume


    // fact_movements_weekly - размещения на складе за неделю
