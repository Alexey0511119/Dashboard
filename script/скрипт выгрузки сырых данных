#!/usr/bin/env python3
import pymssql
import logging
import os
from datetime import date
import calendar

SRC_SERVER = '10.7.0.248'
SRC_PORT = 1433
SRC_DATABASE = 'ils'
SRC_USER = 'manhreader'
SRC_PASSWORD = 'August2021'

DST_SERVER = '10.7.0.27'
DST_DATABASE = 'olap2_fixed'
DST_USER = 'sa'
DST_PASSWORD = 'Rdflhfn600'

log_dir = "/home/admin1/script/logs"
os.makedirs(log_dir, exist_ok=True)
logging.basicConfig(
    filename=os.path.join(log_dir, "reload_feb_mar_2026.log"),
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

TABLES_TO_RELOAD = [
    'LOCATION_INVENTORY',
    'ORDER_DETAIL', 'ORDER_HEADER',
    'RECEIPT_DETAIL', 'RECEIPT_HEADER',
    'SHIPMENT_DETAIL', 'SHIPMENT_HEADER',
    'TRANSACTION_HISTORY',
    'DOWNLOAD_ORDER_DETAIL', 'DOWNLOAD_ORDER_HEADER',
    'DOWNLOAD_RECEIPT_DETAIL', 'DOWNLOAD_RECEIPT_HEADER',
    'UPLOAD_ORDER_DETAIL', 'UPLOAD_ORDER_HEADER',
    'UPLOAD_RECEIPT_DETAIL', 'UPLOAD_RECEIPT_HEADER'
]

UNIQUE_KEYS = {
    'LOCATION_INVENTORY': ['LOCATION', 'ITEM', 'LOT'],
    'ORDER_DETAIL': ['INTERFACE_RECORD_ID'],
    'ORDER_HEADER': ['INTERFACE_RECORD_ID'],
    'RECEIPT_DETAIL': ['INTERFACE_RECORD_ID'],
    'RECEIPT_HEADER': ['INTERFACE_RECORD_ID'],
    'SHIPMENT_DETAIL': ['INTERFACE_RECORD_ID'],
    'SHIPMENT_HEADER': ['INTERFACE_RECORD_ID'],
    'TRANSACTION_HISTORY': ['TRANSACTION_ID', 'DATE_TIME_STAMP'],  # ИСПРАВЛЕНО: составной ключ
    'DOWNLOAD_ORDER_DETAIL': ['INTERFACE_RECORD_ID'],
    'DOWNLOAD_ORDER_HEADER': ['INTERFACE_RECORD_ID'],
    'DOWNLOAD_RECEIPT_DETAIL': ['INTERFACE_RECORD_ID'],
    'DOWNLOAD_RECEIPT_HEADER': ['INTERFACE_RECORD_ID'],
    'UPLOAD_ORDER_DETAIL': ['INTERFACE_RECORD_ID'],
    'UPLOAD_ORDER_HEADER': ['INTERFACE_RECORD_ID'],
    'UPLOAD_RECEIPT_DETAIL': ['INTERFACE_RECORD_ID'],
    'UPLOAD_RECEIPT_HEADER': ['INTERFACE_RECORD_ID']
}

PERIODS = [
    (2026, 2),
    (2026, 3)
]

def get_src_conn():
    return pymssql.connect(
        server=SRC_SERVER,
        port=SRC_PORT,
        user=SRC_USER,
        password=SRC_PASSWORD,
        database=SRC_DATABASE,
        tds_version='7.0'
    )

def get_dst_conn():
    return pymssql.connect(
        server=DST_SERVER,
        user=DST_USER,
        password=DST_PASSWORD,
        database=DST_DATABASE,
        charset='UTF-8'
    )

def get_date_field(table_name):
    if table_name == 'ORDER_HEADER':
        return 'ORDER_DATE'
    elif table_name == 'RECEIPT_HEADER':
        return 'RECEIPT_DATE'
    elif table_name == 'SHIPMENT_HEADER':
        return 'PLANNED_SHIP_DATE'
    else:
        return 'DATE_TIME_STAMP'

def reload_table_for_period(table_name, year, month):
    start_date = date(year, month, 1)
    end_date = date(year, month, calendar.monthrange(year, month)[1])
    print(f"\n🔄 {table_name} за {year}-{month:02d}")

    src = get_src_conn()
    dst = get_dst_conn()
    date_field = get_date_field(table_name)

    dst_cursor = dst.cursor()
    dst_cursor.execute("""
        SELECT COLUMN_NAME
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = 'raw_' AND TABLE_NAME = %s
        ORDER BY ORDINAL_POSITION
    """, (table_name,))
    target_columns = [row[0] for row in dst_cursor.fetchall()]
    if not target_columns:
        print(f"   ❌ Таблица raw_.{table_name} не найдена")
        return

    # Исключаем IDENTITY-колонки (их нельзя вставлять явно)
    dst_cursor.execute("""
        SELECT c.name
        FROM sys.columns c
        INNER JOIN sys.tables t ON c.object_id = t.object_id
        INNER JOIN sys.schemas s ON t.schema_id = s.schema_id
        WHERE s.name = 'raw_' AND t.name = %s AND c.is_identity = 1
    """, (table_name,))
    identity_columns = [row[0] for row in dst_cursor.fetchall()]
    insert_columns = [col for col in target_columns if col not in identity_columns]
    
    if not insert_columns:
        print(f"   ❌ Нет колонок для вставки (все колонки - IDENTITY)")
        return
    
    print(f"   📋 Колонок всего: {len(target_columns)}, для вставки: {len(insert_columns)} (исключено IDENTITY: {len(identity_columns)})")

    unique_key_cols = UNIQUE_KEYS.get(table_name, ['ROW_ID'])
    tables_to_check = [f"AR_{table_name}", table_name]
    all_rows_with_cols = []

    try:
        for src_table in tables_to_check:
            src_cursor = src.cursor()
            try:
                src_cursor.execute("""
                    SELECT COLUMN_NAME
                    FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE TABLE_NAME = %s
                    ORDER BY ORDINAL_POSITION
                """, (src_table,))
                source_columns = [row[0] for row in src_cursor.fetchall()]
                if not source_columns:
                    print(f"   ⚠️  {src_table} не существует — пропускаем")
                    continue

                common_columns = [col for col in insert_columns if col in source_columns]
                if not common_columns:
                    print(f"   ❌ Нет общих колонок для {src_table}")
                    continue

                column_list = ", ".join(common_columns)
                select_sql = f"SELECT {column_list} FROM {src_table} WHERE {date_field} >= %s AND {date_field} <= %s"
                src_cursor.execute(select_sql, (start_date, end_date))
                rows = src_cursor.fetchall()
                if rows:
                    print(f"   → Из {src_table}: {len(rows)} строк")
                    all_rows_with_cols.append((common_columns, rows))
                else:
                    print(f"   ℹ️  {src_table}: данных нет")

            except pymssql.ProgrammingError as e:
                if "Invalid object name" in str(e):
                    print(f"   ⚠️  {src_table} не существует — пропускаем")
                    continue
                else:
                    raise

        all_records = []
        for cols, rows in all_rows_with_cols:
            for row in rows:
                record = {}
                for i, col in enumerate(cols):
                    record[col] = row[i]
                for col in insert_columns:
                    if col not in record:
                        record[col] = None
                all_records.append(record)

        if all_records:
            # Удаление дублей ТОЛЬКО для таблиц с уникальным ключом
            # Для TRANSACTION_HISTORY теперь используем составной ключ
            if table_name == 'TRANSACTION_HISTORY':
                # Для TRANSACTION_HISTORY не удаляем дубли - вставляем всё как есть
                deduped_records = all_records
                print(f"   📊 TRANSACTION_HISTORY: вставка всех {len(deduped_records):,} строк (без удаления дублей)")
            else:
                seen = {}
                for rec in all_records:
                    key_parts = []
                    for col in unique_key_cols:
                        val = rec.get(col)
                        key_parts.append(str(val) if val is not None else '')
                    key = '|'.join(key_parts)
                    seen[key] = rec

                deduped_records = list(seen.values())
                print(f"   🧹 После удаления дублей: {len(deduped_records):,} строк")

            deduped_rows = []
            for rec in deduped_records:
                row_tuple = tuple(rec[col] for col in insert_columns)
                deduped_rows.append(row_tuple)

            # Удаляем старые данные за период
            delete_sql = f"DELETE FROM raw_.{table_name} WHERE {date_field} >= %s AND {date_field} <= %s"
            dst_cursor.execute(delete_sql, (start_date, end_date))
            deleted = dst_cursor.rowcount
            dst.commit()
            print(f"   🗑️ Удалено старых: {deleted:,} строк")

            # Вставляем новые данные
            placeholders = ",".join(["%s"] * len(insert_columns))
            insert_sql = f"INSERT INTO raw_.{table_name} ({', '.join(insert_columns)}) VALUES ({placeholders})"
            dst_cursor.executemany(insert_sql, deduped_rows)
            dst.commit()
            print(f"   ✅ Загружено: {len(deduped_rows):,} строк")
        else:
            print(f"   ℹ️  Нет данных для перезагрузки")

    except Exception as e:
        print(f"   ❌ ОШИБКА: {e}")
        import traceback
        traceback.print_exc()
    finally:
        src.close()
        dst.close()

def main():
    print("=== ПЕРЕЗАГРУЗКА ФЕВРАЛЯ И МАРТА 2026 ===")
    for year, month in PERIODS:
        print(f"\n📅 Месяц: {year}-{month:02d}")
        for tbl in TABLES_TO_RELOAD:
            reload_table_for_period(tbl, year, month)
    print("\n🏁 Перезагрузка завершена")

if __name__ == "__main__":
    main()
